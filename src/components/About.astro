---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="about" class="about">
  <div class="stars" aria-hidden="true">
    <span class="st" style="top:12%;left:18%"></span>
    <span class="st" style="top:22%;left:70%"></span>
    <span class="st" style="top:38%;left:42%"></span>
    <span class="st" style="top:60%;left:14%"></span>
    <span class="st" style="top:72%;left:80%"></span>
    <span class="st" style="top:30%;left:88%"></span>
  </div>
  <div class="moon" aria-hidden="true"></div>

  <div class="about-inner wrap">
    <!-- left: product designer -->
    <figure class="fig fig-left reveal">
      <img src={`${base}/images/product-designer.png`} alt="Illustration of Aishwarya at her product-design desk" loading="lazy" style="max-width:480px" />
      <figcaption>this is me, mostly ✦</figcaption>
    </figure>

    <!-- right: bio -->
    <div class="about-copy reveal">
      <p class="eyebrow">/ about me</p>
      <h2 class="about-h">Nice to <span class="hand">meet you.</span></h2>

      <p class="about-p lead">
        I'm Aishwarya Srivastava, a UX Designer based in Bangalore with 5 years of
        experience shaping web and mobile apps, CRM tools, and dashboards used by
        real teams solving real problems. My work sits at the intersection of
        clarity and craft — taking complex systems and making them feel simple to use.
      </p>
      <p class="about-p">
        An architecture background gave me an eye for structure and flow, which now
        shows up in how I approach research, solutioning, and iteration. I work
        closely with stakeholders and developers to ship designs that hold up in
        production, not just in Figma — with design systems and AI tools woven into
        how I work.
      </p>
      <p class="ps">
        Outside of work, you'll find me sketching, singing, or exploring new places
        for a bit of fresh inspiration.
      </p>
    </div>
  </div>

  <a href={`${base}/#work`} class="scroll-cue" aria-label="Scroll to work">
    <span>the work</span>
    <span class="cue-arrow">↓</span>
  </a>
</section>

<style>
  .about {
    position: relative;
    background: radial-gradient(120% 90% at 80% 10%, #1b2650 0%, #0d1430 45%, #080d22 100%);
    color: #eaeefb;
    padding-block: clamp(5rem, 12vh, 9rem);
    overflow: hidden;
  }
  .stars { position: absolute; inset: 0; pointer-events: none; }
  .st {
    position: absolute;
    width: 3px; height: 3px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 6px 1px #fff;
    animation: tw 3.5s ease-in-out infinite;
  }
  .st:nth-child(2n) { animation-delay: 1s; }
  .st:nth-child(3n) { animation-delay: 2s; }
  @keyframes tw {
    0%, 100% { opacity: 0.3; transform: scale(0.8); }
    50% { opacity: 1; transform: scale(1.2); }
  }
  .moon {
    position: absolute;
    top: 7%; left: 5%;
    width: 110px; height: 110px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #f4f1e6 0%, #d8d2bf 60%, #b9b3a0 100%);
    box-shadow: 0 0 60px 8px rgba(244, 241, 230, 0.25);
    opacity: 0.85;
  }

  .about-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(300px, 480px) 1fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  /* ---- figure ---- */
  .fig {
    margin: 0;
    text-align: center;
    justify-self: center;
  }
  .fig img {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 22px 34px rgba(0, 0, 0, 0.45));
    animation: floaty-l 7s ease-in-out infinite;
  }
  .fig figcaption {
    margin-top: 0.75rem;
    font-family: var(--font-hand);
    font-size: 1.4rem;
    color: #ff9a8b;
  }
  @keyframes floaty-l {
    0%, 100% { transform: translateY(0) rotate(-1.5deg); }
    50% { transform: translateY(-12px) rotate(-1.5deg); }
  }

  /* ---- copy ---- */
  .about-copy { text-align: left; }
  .about-copy .eyebrow { color: #9fb0d8; }
  .about-h {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #f4f7ff;
    margin-bottom: 1.75rem;
  }
  .about-h .hand {
    font-family: var(--font-hand);
    font-weight: 700;
    color: #ff9a8b;
    font-size: 1.15em;
  }
  .about-p {
    margin: 0 0 1.25rem;
    font-size: 1.02rem;
    line-height: 1.7;
    color: #c3cde6;
    max-width: 46ch;
  }
  .about-p.lead {
    font-size: 1.12rem;
    color: #dbe3f5;
  }
  .ps {
    margin: 1.5rem 0 0;
    max-width: 46ch;
    font-family: var(--font-hand);
    font-size: 1.4rem;
    line-height: 1.3;
    color: #ffb3a6;
  }

  /* scroll cue */
  .scroll-cue {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    color: #b9c6e6;
  }
  .cue-arrow { font-style: normal; animation: nudge 1.8s ease-in-out infinite; }
  @keyframes nudge {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50% { transform: translateY(6px); opacity: 1; }
  }

  /* reserve room for the floating dock so copy never runs under it */
  @media (min-width: 861px) {
    .about-copy { padding-right: 90px; }
  }

  @media (max-width: 860px) {
    .about-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      text-align: center;
    }
    .about-copy { text-align: center; }
    .about-p, .ps { margin-left: auto; margin-right: auto; }
    .fig img { max-width: 300px !important; }
    .moon { width: 70px; height: 70px; top: 2%; left: auto; right: 7%; }
    .scroll-cue { display: none; }
  }
</style>
