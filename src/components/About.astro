---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="about" class="about">
  <!-- night sky (dark theme) -->
  <div class="stars" aria-hidden="true">
    <span class="st" style="top:12%;left:18%"></span>
    <span class="st" style="top:22%;left:70%"></span>
    <span class="st" style="top:38%;left:42%"></span>
    <span class="st" style="top:60%;left:14%"></span>
    <span class="st" style="top:72%;left:80%"></span>
    <span class="st" style="top:30%;left:88%"></span>
  </div>
  <div class="moon" aria-hidden="true"></div>

  <!-- day sky (light theme): drifting birds -->
  <div class="birds" aria-hidden="true">
    <span class="bird b1"><svg viewBox="0 0 24 10"><path d="M1 8 Q6 1 12 6 Q18 1 23 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span>
    <span class="bird b2"><svg viewBox="0 0 24 10"><path d="M1 8 Q6 1 12 6 Q18 1 23 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span>
    <span class="bird b3"><svg viewBox="0 0 24 10"><path d="M1 8 Q6 1 12 6 Q18 1 23 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span>
    <span class="bird b4"><svg viewBox="0 0 24 10"><path d="M1 8 Q6 1 12 6 Q18 1 23 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span>
    <span class="bird b5"><svg viewBox="0 0 24 10"><path d="M1 8 Q6 1 12 6 Q18 1 23 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span>
  </div>

  <div class="about-inner wrap">
    <!-- left: product designer -->
    <figure class="fig fig-left reveal">
      <img src={`${base}/images/product-designer.png`} alt="Illustration of Aishwarya at her product-design desk" loading="lazy" style="max-width:480px" />
      <figcaption>this is me, mostly ✦</figcaption>
    </figure>

    <!-- right: bio -->
    <div class="about-copy reveal">
      <p class="eyebrow">/ about me</p>
      <h2 class="about-h">Nice to <span class="hand">meet you.</span></h2>

      <p class="about-p lead">
        I'm Aishwarya, a UX designer in Bangalore. Over the past five years I've
        worked on web and mobile apps, CRM tools, and dashboards that real teams
        rely on to get real work done. What I care about most is clarity: taking
        something complicated and making it feel simple.
      </p>
      <p class="about-p">
        I studied architecture before I found design, and that background still
        shapes how I think about structure and flow. It shows up in how I research,
        work through messy problems, and keep refining until things click. I like
        working closely with product folks and engineers, so the designs actually
        hold up once they ship and not just in Figma. Design systems and a bit of
        AI are part of how I get there.
      </p>
      <p class="ps">
        When I'm not working, you'll usually find me sketching, singing, or off
        exploring somewhere new for a little fresh inspiration.
      </p>
    </div>
  </div>

  <a href={`${base}/#work`} class="scroll-cue" aria-label="Scroll to work">
    <span>the work</span>
    <span class="cue-arrow">↓</span>
  </a>
</section>

<style>
  .about {
    position: relative;
    /* light theme: day sky */
    background: linear-gradient(180deg, #8fc4f5 0%, #bfe0fb 45%, #e9f4ff 100%);
    color: #1e2c4f;
    padding-block: clamp(5rem, 12vh, 9rem);
    overflow: hidden;
  }
  :global([data-theme='dark']) .about {
    /* dark theme: night sky */
    background: radial-gradient(120% 90% at 80% 10%, #1b2650 0%, #0d1430 45%, #080d22 100%);
    color: #eaeefb;
  }

  /* stars + moon only at night */
  .stars, .moon { display: none; }
  :global([data-theme='dark']) .stars,
  :global([data-theme='dark']) .moon { display: block; }

  .stars { position: absolute; inset: 0; pointer-events: none; }
  .st {
    position: absolute;
    width: 3px; height: 3px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 6px 1px #fff;
    animation: tw 3.5s ease-in-out infinite;
  }
  .st:nth-child(2n) { animation-delay: 1s; }
  .st:nth-child(3n) { animation-delay: 2s; }
  @keyframes tw {
    0%, 100% { opacity: 0.3; transform: scale(0.8); }
    50% { opacity: 1; transform: scale(1.2); }
  }
  .moon {
    position: absolute;
    top: 7%; left: 5%;
    width: 110px; height: 110px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #f4f1e6 0%, #d8d2bf 60%, #b9b3a0 100%);
    box-shadow: 0 0 60px 8px rgba(244, 241, 230, 0.25);
    opacity: 0.85;
  }

  /* ---- birds (day theme only) ---- */
  .birds { position: absolute; inset: 0; pointer-events: none; }
  :global([data-theme='dark']) .birds { display: none; }
  .bird {
    position: absolute;
    color: #2b3d5a;
    opacity: 0.7;
    will-change: transform;
  }
  .bird svg {
    display: block;
    width: 100%;
    height: auto;
    animation: flap 0.5s ease-in-out infinite alternate;
    transform-origin: center;
  }
  @keyframes flap {
    from { transform: scaleY(1); }
    to { transform: scaleY(0.55); }
  }
  @keyframes fly {
    0%   { transform: translate(-12vw, 0); }
    50%  { transform: translate(52vw, -26px); }
    100% { transform: translate(116vw, 6px); }
  }
  .b1 { top: 16%; width: 26px; animation: fly 22s linear infinite; }
  .b2 { top: 22%; width: 20px; animation: fly 28s linear infinite; animation-delay: -6s; opacity: 0.55; }
  .b3 { top: 30%; width: 30px; animation: fly 19s linear infinite; animation-delay: -12s; }
  .b4 { top: 12%; width: 18px; animation: fly 32s linear infinite; animation-delay: -3s; opacity: 0.5; }
  .b5 { top: 38%; width: 22px; animation: fly 25s linear infinite; animation-delay: -18s; opacity: 0.6; }
  .bird svg { animation-delay: inherit; }

  .about-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(300px, 480px) 1fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  /* ---- figure ---- */
  .fig {
    margin: 0;
    text-align: center;
    justify-self: center;
  }
  .fig img {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 22px 34px rgba(0, 0, 0, 0.45));
    animation: floaty-l 7s ease-in-out infinite;
  }
  .fig figcaption {
    margin-top: 0.75rem;
    font-family: var(--font-hand);
    font-size: 1.4rem;
    color: #d9604a;
  }
  :global([data-theme='dark']) .fig figcaption { color: #ff9a8b; }
  @keyframes floaty-l {
    0%, 100% { transform: translateY(0) rotate(-1.5deg); }
    50% { transform: translateY(-12px) rotate(-1.5deg); }
  }

  /* ---- copy ---- */
  .about-copy { text-align: left; }
  .about-copy .eyebrow { color: #3a5573; }
  .about-h {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #12233c;
    margin-bottom: 1.75rem;
  }
  .about-h .hand {
    font-family: var(--font-hand);
    font-weight: 700;
    color: #e26a54;
    font-size: 1.15em;
  }
  .about-p {
    margin: 0 0 1.25rem;
    font-size: 1.02rem;
    line-height: 1.7;
    color: #35465f;
    max-width: 46ch;
  }
  .about-p.lead {
    font-size: 1.12rem;
    color: #22314c;
  }
  .ps {
    margin: 1.5rem 0 0;
    max-width: 46ch;
    font-family: var(--font-hand);
    font-size: 1.4rem;
    line-height: 1.3;
    color: #d9604a;
  }

  /* dark-theme text colors */
  :global([data-theme='dark']) .about-copy .eyebrow { color: #9fb0d8; }
  :global([data-theme='dark']) .about-h { color: #f4f7ff; }
  :global([data-theme='dark']) .about-h .hand { color: #ff9a8b; }
  :global([data-theme='dark']) .about-p { color: #c3cde6; }
  :global([data-theme='dark']) .about-p.lead { color: #dbe3f5; }
  :global([data-theme='dark']) .ps { color: #ffb3a6; }

  /* scroll cue */
  .scroll-cue {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    color: #2b4d6e;
  }
  :global([data-theme='dark']) .scroll-cue { color: #b9c6e6; }
  .cue-arrow { font-style: normal; animation: nudge 1.8s ease-in-out infinite; }
  @keyframes nudge {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50% { transform: translateY(6px); opacity: 1; }
  }

  /* reserve room for the floating dock so copy never runs under it */
  @media (min-width: 861px) {
    .about-copy { padding-right: 90px; }
  }

  @media (max-width: 860px) {
    .about-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      text-align: center;
    }
    .about-copy { text-align: center; }
    .about-p, .ps { margin-left: auto; margin-right: auto; }
    .fig img { max-width: 300px !important; }
    .moon { width: 70px; height: 70px; top: 2%; left: auto; right: 7%; }
    .scroll-cue { display: none; }
  }
</style>
