---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const journey = [
  { year: '2026', title: 'Senior UX Designer · Tech Mahindra', text: 'Leading end-to-end UX for British Telecom’s PNI platform, from research to developer handoff.' },
  { year: '2025', title: 'Independent Designer · UXwithAish', text: 'AI-assisted UX workflows and high-converting sites for small businesses, alongside a PG at IIT Madras in Gen AI & Agentic AI.' },
  { year: '2022', title: 'UX Designer II · Ollion', text: 'Tata Neu Connect, cloud Landing Zone dashboards, healthcare and logistics platforms, plus a design system that cut delivery time by 40%.' },
  { year: '2021', title: 'Associate UX/UI Designer · mVerve', text: 'Enterprise CRM platforms for industrial and manufacturing teams.' },
  { year: '2021', title: 'UX/UI Bootcamp · DesignBoat', text: 'Made the leap into product design.' },
  { year: '2018–2020', title: 'Architect · Architecture firms', text: 'Worked as an architect across firms on hotels, housing societies, interiors, and government and semi-government projects.' },
  { year: '2018', title: 'B.Arch · BIT Mesra', text: 'An architecture degree that taught me structure, flow, and systems thinking.' },
];
---

<section id="about" class="about">
  <div class="about-inner wrap">
    <!-- left: product designer -->
    <figure class="fig fig-left reveal">
      <img src={`${base}/images/product-designer.png`} alt="Illustration of Aishwarya at her product-design desk" loading="lazy" style="max-width:480px" />
      <figcaption>this is me, mostly ✦</figcaption>
    </figure>

    <!-- right: bio -->
    <div class="about-copy reveal">
      <p class="eyebrow">/ about me</p>
      <h2 class="about-h">Nice to <span class="hand">meet you.</span></h2>

      <p class="about-p lead">
        I'm Aishwarya, a Senior UX/UI & Product Designer in Bangalore with 5+ years
        across enterprise SaaS, telecom, cloud, healthcare, logistics, and CRM. I'm
        currently leading end-to-end UX for British Telecom's PNI platform at Tech
        Mahindra. What I care about most is clarity: taking something complicated and
        making it feel simple.
      </p>
      <p class="about-p">
        I studied architecture before I found design, and that background still
        shapes how I think about structure and flow. It shows up in how I research,
        work through messy problems, and keep refining until things click. I like
        working closely with product folks and engineers, so the designs actually
        hold up once they ship and not just in Figma. Design systems and a bit of
        AI are part of how I get there.
      </p>
      <ul class="stats">
        <li><strong>5+</strong><span>years designing</span></li>
        <li><strong>~40%</strong><span>faster delivery</span></li>
        <li><strong>🏆 3</strong><span>spot awards</span></li>
      </ul>

      <p class="ps">
        When I'm not working, you'll usually find me sketching, singing, or off
        exploring somewhere new for a little fresh inspiration.
      </p>
    </div>
  </div>

  <div class="journey wrap reveal">
    <div class="journey-body">
      <p class="eyebrow">/ my journey</p>
      <h3 class="journey-h">My <span class="hand">journey</span> so far.</h3>
      <ol class="timeline">
        {journey.map((j) => (
          <li>
            <span class="tl-dot"></span>
            <span class="tl-year">{j.year}</span>
            <div class="tl-body">
              <h4>{j.title}</h4>
              <p>{j.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
    <img
      class="journey-figure"
      src={`${base}/images/sticker-point-left.png`}
      alt="Illustration of Aishwarya pointing at her journey"
      loading="lazy"
    />
  </div>

  <a href={`${base}/#work`} class="scroll-cue" aria-label="Scroll to work">
    <span>the work</span>
    <span class="cue-arrow">↓</span>
  </a>
</section>

<style>
  .about {
    position: relative;
    /* background is provided by the shared .sky-world wrapper */
    color: #1e2c4f;
    padding-block: clamp(5rem, 12vh, 9rem);
    overflow: hidden;
  }
  :global([data-theme='dark']) .about { color: #eaeefb; }

  .about-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(300px, 480px) 1fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  /* ---- figure ---- */
  .fig {
    margin: 0;
    text-align: center;
    justify-self: center;
  }
  .fig img {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 22px 34px rgba(0, 0, 0, 0.45));
    animation: floaty-l 7s ease-in-out infinite;
  }
  .fig figcaption {
    margin-top: 0.75rem;
    font-family: var(--font-hand);
    font-size: 1.4rem;
    color: #d9604a;
  }
  :global([data-theme='dark']) .fig figcaption { color: #ff9a8b; }
  @keyframes floaty-l {
    0%, 100% { transform: translateY(0) rotate(-1.5deg); }
    50% { transform: translateY(-12px) rotate(-1.5deg); }
  }

  /* ---- copy ---- */
  .about-copy { text-align: left; }
  .about-copy .eyebrow { color: #3a5573; }
  .about-h {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #12233c;
    margin-bottom: 1.75rem;
  }
  .about-h .hand {
    font-family: var(--font-hand);
    font-weight: 700;
    color: #e26a54;
    font-size: 1.15em;
  }
  .about-p {
    margin: 0 0 1.25rem;
    font-size: 1.02rem;
    line-height: 1.7;
    color: #35465f;
    max-width: 46ch;
  }
  .about-p.lead {
    font-size: 1.12rem;
    color: #22314c;
  }
  .ps {
    margin: 1.5rem 0 0;
    max-width: 46ch;
    font-family: var(--font-hand);
    font-size: 1.4rem;
    line-height: 1.3;
    color: #d9604a;
  }

  /* dark-theme text colors */
  :global([data-theme='dark']) .about-copy .eyebrow { color: #9fb0d8; }
  :global([data-theme='dark']) .about-h { color: #f4f7ff; }
  :global([data-theme='dark']) .about-h .hand { color: #ff9a8b; }
  :global([data-theme='dark']) .about-p { color: #c3cde6; }
  :global([data-theme='dark']) .about-p.lead { color: #dbe3f5; }
  :global([data-theme='dark']) .ps { color: #ffb3a6; }

  /* scroll cue */
  .scroll-cue {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    color: #2b4d6e;
  }
  :global([data-theme='dark']) .scroll-cue { color: #b9c6e6; }
  .cue-arrow { font-style: normal; animation: nudge 1.8s ease-in-out infinite; }
  @keyframes nudge {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50% { transform: translateY(6px); opacity: 1; }
  }

  /* reserve room for the floating dock so copy never runs under it */
  @media (min-width: 861px) {
    .about-copy { padding-right: 90px; }
  }

  /* ---- credibility stats ---- */
  .stats {
    display: flex;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    flex-wrap: wrap;
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
  }
  .stats li {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .stats strong {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 400;
    color: #12233c;
  }
  :global([data-theme='dark']) .stats strong { color: #f4f7ff; }
  .stats span {
    margin-top: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #4a6083;
  }
  :global([data-theme='dark']) .stats span { color: #9fb0d8; }

  /* ---- my journey ---- */
  .journey {
    position: relative;
    z-index: 2;
    margin-top: clamp(3.5rem, 7vh, 6rem);
  }
  .journey-h {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    letter-spacing: -0.02em;
    color: #12233c;
    margin-bottom: 2rem;
  }
  :global([data-theme='dark']) .journey-h { color: #f4f7ff; }
  .journey-h .hand {
    font-family: var(--font-hand);
    font-weight: 700;
    color: #e26a54;
    font-size: 1.15em;
  }
  :global([data-theme='dark']) .journey-h .hand { color: #ff9a8b; }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.75rem;
    border-left: 2px solid color-mix(in srgb, #1e2c4f 22%, transparent);
    display: grid;
    gap: 1.9rem;
    max-width: 640px;
  }
  :global([data-theme='dark']) .timeline {
    border-left-color: color-mix(in srgb, #ffffff 22%, transparent);
  }
  .timeline li { position: relative; }
  .tl-dot {
    position: absolute;
    left: calc(-1.75rem - 6px);
    top: 5px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 22%, transparent);
  }
  .tl-year {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--accent);
  }
  .tl-body h4 {
    margin-top: 0.25rem;
    font-size: 1.12rem;
    letter-spacing: -0.01em;
    color: #1e2c4f;
  }
  :global([data-theme='dark']) .tl-body h4 { color: #eef1f7; }
  .tl-body p {
    margin-top: 0.4rem;
    font-size: 0.98rem;
    line-height: 1.55;
    color: #3a4a63;
    max-width: 52ch;
  }
  :global([data-theme='dark']) .tl-body p { color: #c3cde6; }

  /* pointing sticker beside the journey */
  .journey-figure { display: none; }
  @media (min-width: 1000px) {
    .journey { position: relative; }
    .journey-body { padding-right: 380px; }
    .journey-figure {
      display: block;
      position: absolute;
      right: 0;
      top: 56%;
      transform: translateY(-50%);
      width: clamp(280px, 26vw, 360px);
      height: auto;
      filter: drop-shadow(0 20px 30px rgba(20, 40, 70, 0.25));
      animation: float-jr 7s ease-in-out infinite;
      pointer-events: none;
    }
    @keyframes float-jr {
      0%, 100% { transform: translateY(-50%); }
      50% { transform: translateY(calc(-50% - 12px)); }
    }
  }

  @media (max-width: 860px) {
    .about-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      text-align: center;
    }
    .about-copy { text-align: center; }
    .about-p, .ps { margin-left: auto; margin-right: auto; }
    .stats { justify-content: center; }
    .fig img { max-width: 300px !important; }
    .scroll-cue { display: none; }
  }
</style>
