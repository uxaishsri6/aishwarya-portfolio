---
interface Slide {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  link?: {
    href: string;
    label: string;
    left: number;
    top: number;
    width: number;
    height: number;
  };
  motion?: {
    src: string;
    poster: string;
    left: number;
    top: number;
    width: number;
    height: number;
  };
}

interface Props {
  slug: string;
  slides: Slide[];
}

const { slug, slides } = Astro.props;
const [cover, ...remainingSlides] = slides;
---

<div class="case-deck">
  {cover && (
    <figure class="case-slide project-cover" transition:name={`cover-${slug}`}>
      <img
        src={cover.src}
        alt={cover.alt}
        width={cover.width}
        height={cover.height}
        loading="eager"
        decoding="async"
      />
    </figure>
  )}
  {remainingSlides.map((slide) => (
    <figure class="case-slide" style={slide.link || slide.motion ? 'position:relative' : undefined}>
      <img
        src={slide.src}
        alt={slide.alt}
        width={slide.width}
        height={slide.height}
        loading="lazy"
        decoding="async"
      />
      {slide.link && (
        <a
          class="slide-link"
          href={slide.link.href}
          aria-label={slide.link.label}
          target="_blank"
          rel="noopener noreferrer"
          style={`position:absolute;left:${slide.link.left}%;top:${slide.link.top}%;width:${slide.link.width}%;height:${slide.link.height}%`}
        ></a>
      )}
      {slide.motion && (
        <video
          class="slide-motion"
          data-play-in-view
          aria-hidden="true"
          muted
          loop
          playsinline
          preload="none"
          poster={slide.motion.poster}
          style={`position:absolute;left:${slide.motion.left}%;top:${slide.motion.top}%;width:${slide.motion.width}%;height:${slide.motion.height}%`}
        >
          <source src={slide.motion.src} type="video/mp4" />
        </video>
      )}
    </figure>
  ))}
</div>

<style>
  .case-deck {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
  }
  .case-slide {
    position: relative;
    margin: 0;
    width: 100%;
  }
  .slide-link {
    position: absolute;
    border-radius: 8px;
  }
  .slide-link:hover,
  .slide-link:focus-visible {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .slide-link:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }
  .slide-motion {
    position: absolute;
    display: block;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .slide-motion { display: none; }
  }
  .case-slide img {
    width: 100%;
    height: auto;
    display: block;
    margin-bottom: -1px;
  }
</style>
