---
interface Slide {
  src: string;
  alt: string;
  width?: number;
  height?: number;
}

interface Props {
  slug: string;
  slides: Slide[];
}

const { slug, slides } = Astro.props;
const [cover, ...remainingSlides] = slides;
---

<div class="case-deck">
  {cover && (
    <figure class="case-slide project-cover" transition:name={`cover-${slug}`}>
      <img
        src={cover.src}
        alt={cover.alt}
        width={cover.width}
        height={cover.height}
        loading="eager"
        decoding="async"
      />
    </figure>
  )}
  {remainingSlides.map((slide) => (
    <figure class="case-slide">
      <img
        src={slide.src}
        alt={slide.alt}
        width={slide.width}
        height={slide.height}
        loading="lazy"
        decoding="async"
      />
    </figure>
  ))}
</div>

<style>
  .case-deck {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
  }
  .case-slide {
    margin: 0;
    width: 100%;
  }
  .case-slide img {
    width: 100%;
    height: auto;
    display: block;
    margin-bottom: -1px;
  }
</style>
