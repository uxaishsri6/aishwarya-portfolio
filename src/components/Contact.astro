---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const email = "uxaishsri6@gmail.com";
const socials = [
  { label: "LinkedIn", href: "https://www.linkedin.com/in/aishwarya-srivastava-499508211/" },
  { label: "Behance", href: "#" },
  { label: "Instagram", href: "#" },
];
const year = new Date().getFullYear();
---

<section id="contact" class="contact">
  <div class="contact-inner wrap">
    <div class="contact-panel reveal">
      <p class="eyebrow">/ contact</p>
      <h2 class="big-cta">Let's <span class="hand">talk.</span></h2>
      <p class="contact-lede">
        Open to product design roles, thoughtful freelance case studies, and the
        occasional lovely collaboration.
      </p>
      <a class="mail magnetic" href={`mailto:${email}`}>{email} →</a>
      <ul class="socials">
        {socials.map((s) => (
          <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>
        ))}
      </ul>
      <p class="contact-meta">© {year} Aishwarya Srivastava · Bengaluru, IST · handmade with care</p>
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    min-height: clamp(560px, 82vh, 900px);
    display: flex;
    align-items: center;
    overflow: hidden;
    /* light theme: day garden */
    background-image: url('/aishwarya-portfolio/images/contact-day-v5.jpg');
    background-size: cover;
    background-position: center;
  }
  :global([data-theme='dark']) .contact {
    background-image: url('/aishwarya-portfolio/images/contact-night-v5.jpg');
  }
  /* seamless top + bottom fades into the page background */
  .contact::before,
  .contact::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 22%;
    pointer-events: none;
    z-index: 1;
  }
  .contact::before {
    top: 0;
    background: linear-gradient(180deg, var(--paper), transparent);
  }
  .contact::after {
    bottom: 0;
    background: linear-gradient(0deg, var(--paper), transparent);
  }

  .contact-inner {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  /* frosted panel keeps the copy readable over the illustration */
  .contact-panel {
    max-width: 440px;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    border-radius: 24px;
    background: color-mix(in srgb, var(--card) 80%, transparent);
    border: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
    backdrop-filter: saturate(1.3) blur(12px);
    box-shadow: 0 30px 70px -34px rgba(20, 40, 70, 0.55);
  }
  .big-cta {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2.6rem, 7vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .big-cta .hand {
    font-family: var(--font-hand);
    font-weight: 700;
    color: var(--accent);
    font-size: 1.1em;
  }
  .contact-lede {
    max-width: 34ch;
    margin: 1.25rem 0 0;
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .mail {
    display: inline-block;
    margin-top: 1.75rem;
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 3vw, 2rem);
    color: var(--ink);
    border-bottom: 2px solid var(--accent);
    padding-bottom: 0.2rem;
    transition: color 0.3s var(--ease);
  }
  .mail:hover { color: var(--accent); }
  .socials {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .socials a {
    color: var(--ink-soft);
    transition: color 0.2s var(--ease);
  }
  .socials a:hover { color: var(--accent); }
  .contact-meta {
    margin-top: 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
  }

  @media (max-width: 600px) {
    .contact { min-height: 620px; }
    .contact-panel { max-width: 100%; }
  }
</style>
