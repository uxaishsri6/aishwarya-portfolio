---
// Update the email and social links below.
const email = "aishwarya.sri2608@gmail.com";
const socials = [
  { label: "LinkedIn", href: "#" },
  { label: "Behance", href: "#" },
  { label: "Instagram", href: "#" },
];
---

<section id="contact" class="contact reveal">
  <p class="eyebrow">/ contact</p>
  <h2 class="big-cta">Let's <em>talk.</em></h2>
  <p class="contact-lede">
    Open to senior product design roles, thoughtful freelance case studies, and the occasional weird collaboration.
  </p>
  <a class="mail magnetic" href={`mailto:${email}`}>{email} →</a>
  <ul class="socials">
    {socials.map((s) => (
      <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>
    ))}
  </ul>
</section>

<style>
  .contact {
    padding-top: 8rem;
    text-align: center;
  }
  .big-cta {
    font-size: clamp(3rem, 12vw, 8rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  .contact-lede {
    max-width: 40ch;
    margin: 1.5rem auto 0;
    color: var(--ink-soft);
    font-size: 1.15rem;
  }
  .mail {
    display: inline-block;
    margin-top: 2.5rem;
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 4vw, 2.6rem);
    color: var(--ink);
    border-bottom: 2px solid var(--accent);
    padding-bottom: 0.25rem;
    transition: color 0.3s var(--ease);
  }
  .mail:hover {
    color: var(--accent);
  }
  .socials {
    display: flex;
    gap: 2rem;
    justify-content: center;
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
  .socials a {
    color: var(--ink-soft);
    transition: color 0.2s var(--ease);
  }
  .socials a:hover {
    color: var(--accent);
  }
</style>
