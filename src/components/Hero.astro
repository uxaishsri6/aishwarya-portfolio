---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="cover" id="top">
  <!-- sky + drifting clouds -->
  <div class="sky" aria-hidden="true">
    <span class="star s1"></span><span class="star s2"></span>
    <span class="star s3"></span><span class="star s4"></span>
    <span class="star s5"></span><span class="star s6"></span>

    <img class="cloud c-back" src={`${base}/images/cloud-2.png`} alt="" style="top:12%; left:-28%; width:300px; --dur:120s;" />
    <img class="cloud c-back" src={`${base}/images/cloud-1.png`} alt="" style="top:40%; left:-34%; width:260px; --dur:150s; --delay:-40s;" />
    <img class="cloud c-mid" src={`${base}/images/cloud-1.png`} alt="" style="top:6%;  left:-30%; width:380px; --dur:95s;" />
    <img class="cloud c-mid" src={`${base}/images/cloud-2.png`} alt="" style="top:56%; left:-30%; width:340px; --dur:105s; --delay:-30s;" />
    <img class="cloud c-front" src={`${base}/images/cloud-1.png`} alt="" style="bottom:4%; left:-32%; width:460px; --dur:80s;" />
  </div>

  <div class="cover-inner wrap">
    <!-- left: copy -->
    <div class="lede-col reveal">
      <p class="hello"><span class="diamond">◆</span> <em>Hello, I'm Aishwarya.</em></p>

      <h1 class="cover-h">
        I design products
        <span class="line2">that feel <em>honest.</em></span>
      </h1>

      <p class="sub">UX DESIGNER<span class="sep">—</span>5 YEARS<span class="sep">·</span>BENGALURU</p>

      <div class="cover-actions">
        <a href={`${base}/#work`} class="btn primary magnetic">See selected work <span class="arr">↘</span></a>
        <a href={`${base}/#contact`} class="btn ghost">Say hello</a>
      </div>
    </div>

    <!-- right: sticker on a cloud -->
    <div class="hero-figure reveal">
      <img class="seat-cloud" src={`${base}/images/cloud-1.png`} alt="" aria-hidden="true" />
      <img
        class="me-sticker"
        src={`${base}/images/sticker-jump.png`}
        alt="Illustration of Aishwarya, mid-celebration, floating on a cloud"
        width="979"
        height="1532"
        fetchpriority="high"
      />
      <span class="spark sp-1" aria-hidden="true">✦</span>
      <span class="spark sp-2" aria-hidden="true">✦</span>
    </div>
  </div>

  <a href={`${base}/#about`} class="scroll-cue" aria-label="Scroll to about">
    <span>the professional side</span>
    <span class="cue-arrow">↓</span>
  </a>
</section>

<style>
  .cover {
    position: relative;
    /* pull the sky up behind the transparent topbar */
    margin-top: calc(-1 * var(--nav-h));
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    /* daytime sky */
    background: linear-gradient(
      180deg,
      #7cc0f5 0%,
      #a9d6fb 26%,
      #d3ecff 52%,
      color-mix(in srgb, var(--paper) 88%, #d3ecff) 100%
    );
  }
  :global([data-theme='dark']) .cover {
    background: linear-gradient(180deg, #0a1430 0%, #142850 42%, #1c2440 74%, var(--paper) 100%);
  }

  /* ---- sky layer ---- */
  .sky {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .star {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #fff;
    opacity: 0;
    box-shadow: 0 0 6px 1px #fff;
  }
  :global([data-theme='dark']) .star {
    opacity: 0.9;
    animation: twinkle 3.5s ease-in-out infinite;
  }
  .s1 { top: 12%; left: 20%; }
  .s2 { top: 22%; left: 65%; animation-delay: .6s; }
  .s3 { top: 30%; left: 40%; animation-delay: 1.2s; }
  .s4 { top: 16%; left: 82%; animation-delay: 1.8s; }
  .s5 { top: 46%; left: 12%; animation-delay: .9s; }
  .s6 { top: 40%; left: 74%; animation-delay: 2.2s; }
  @keyframes twinkle {
    0%, 100% { opacity: .25; transform: scale(.8); }
    50% { opacity: 1; transform: scale(1.15); }
  }

  /* ---- realistic drifting clouds (image) ---- */
  .cloud {
    position: absolute;
    height: auto;
    animation: drift var(--dur, 90s) linear infinite;
    animation-delay: var(--delay, 0s);
    will-change: transform;
    pointer-events: none;
  }
  .c-back { opacity: 0.5; filter: blur(3px); }
  .c-mid { opacity: 0.8; filter: blur(1px); }
  .c-front { opacity: 0.95; }
  :global([data-theme='dark']) .cloud { opacity: 0.16; filter: blur(2px) brightness(0.7); }
  :global([data-theme='dark']) .c-front { opacity: 0.22; }
  @keyframes drift {
    from { transform: translateX(0); }
    to { transform: translateX(180vw); }
  }

  /* ---- layout ---- */
  .cover-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: 2rem;
    width: 100%;
    padding-block: 3rem;
  }

  /* ---- copy ---- */
  .hello {
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 2.4vw, 1.5rem);
    color: #1b3a5b;
    margin-bottom: 1.25rem;
  }
  :global([data-theme='dark']) .hello { color: #dfe9ff; }
  .diamond { color: var(--accent); font-size: 0.7em; vertical-align: middle; }
  .cover-h {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2.8rem, 7vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    color: #10263c;
  }
  :global([data-theme='dark']) .cover-h { color: #f4f0e8; }
  .cover-h .line2 { display: block; }
  .cover-h em {
    font-style: italic;
    color: var(--accent);
  }
  .sub {
    margin-top: 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    color: #35597a;
  }
  :global([data-theme='dark']) .sub { color: #9fb6d4; }
  .sub .sep { margin: 0 0.6rem; opacity: 0.6; }
  .cover-actions {
    margin-top: 2.25rem;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .cover-actions .arr {
    transition: transform 0.3s var(--ease);
  }
  .cover-actions .primary:hover .arr {
    transform: translate(3px, 3px);
  }

  /* ---- figure ---- */
  .hero-figure {
    position: relative;
    justify-self: center;
    width: min(100%, 470px);
    aspect-ratio: 3 / 4;
  }
  .me-sticker {
    position: absolute;
    bottom: 7%;
    left: 50%;
    width: 90%;
    height: auto;
    transform: translateX(-50%);
    filter: drop-shadow(0 24px 30px rgba(20, 40, 70, 0.28));
    animation: bob 7s ease-in-out infinite;
    z-index: 2;
  }
  @keyframes bob {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(-14px); }
  }
  /* the cloud she floats on */
  .seat-cloud {
    position: absolute;
    z-index: 1;
    bottom: -4%;
    left: 50%;
    width: 138%;
    height: auto;
    transform: translateX(-50%);
    filter: drop-shadow(0 20px 26px rgba(20, 40, 70, 0.14));
    animation: bob-cloud 7s ease-in-out infinite;
  }
  @keyframes bob-cloud {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(-8px); }
  }
  .spark {
    position: absolute;
    color: #fff;
    font-size: 1.4rem;
    text-shadow: 0 0 8px var(--accent);
    animation: twinkle 2.6s ease-in-out infinite;
  }
  .sp-1 { top: 8%; left: 6%; }
  .sp-2 { top: 30%; right: 2%; font-size: 1rem; animation-delay: 1.1s; }

  /* ---- scroll cue ---- */
  .scroll-cue {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: 1.75rem;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    color: #2b4d6e;
  }
  :global([data-theme='dark']) .scroll-cue { color: #b9cbe6; }
  .cue-arrow {
    font-style: normal;
    animation: nudge 1.8s ease-in-out infinite;
  }
  @keyframes nudge {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50% { transform: translateY(6px); opacity: 1; }
  }

  @media (max-width: 860px) {
    .cover-inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 1rem;
      padding-top: 2rem;
    }
    .lede-col { order: 2; }
    .hero-figure { order: 1; width: min(80%, 340px); }
    .cover-actions { justify-content: center; }
    .scroll-cue { display: none; }
  }
</style>
