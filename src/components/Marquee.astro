---
const words = ["Considered.", "Human.", "Trusted.", "Honest.", "Playful."];
// duplicate enough times for a seamless loop
const track = Array.from({ length: 4 }, () => words).flat();
---

<div class="serif-marquee" aria-hidden="true">
  <div class="sm-track">
    {track.map((w) => (
      <>
        <span>{w}</span>
        <span class="dot">·</span>
      </>
    ))}
  </div>
</div>

<style>
  .serif-marquee {
    overflow: hidden;
    padding-block: 2.5rem;
    border-block: 1px solid var(--line);
    margin-top: 4rem;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .sm-track {
    display: flex;
    gap: 2rem;
    width: max-content;
    animation: scroll 40s linear infinite;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3.5rem);
    color: var(--ink);
  }
  .sm-track .dot {
    color: var(--accent);
  }
  .serif-marquee:hover .sm-track {
    animation-play-state: paused;
  }
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>
