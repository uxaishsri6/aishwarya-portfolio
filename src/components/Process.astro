---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tenets = [
  {
    n: "01",
    h: "Start with the problem",
    p: "The brief is rarely the whole problem. I spend time understanding the context before moving to solutions.",
    take: "Find the real problem before designing the answer.",
  },
  {
    n: "02",
    h: "Reframe before solving",
    p: "I challenge the initial framing, test assumptions, and make sure we're solving the right problem for the right people.",
    take: "Clarity comes before execution.",
  },
  {
    n: "03",
    h: "Design the system",
    p: "I think beyond individual screens, to components, states, edge cases, and how the experience scales.",
    take: "Design for the product, not just the pixel.",
  },
  {
    n: "04",
    h: "Work with constraints",
    p: "Technical, business, and time constraints are part of the problem, not something to solve around later.",
    take: "Constraints shape better solutions.",
  },
  {
    n: "05",
    h: "Prototype to learn",
    p: "I use prototypes to test ideas and create alignment, keeping early work lightweight enough to change.",
    take: "Prototype to learn, not to impress.",
  },
  {
    n: "06",
    h: "Ship and keep listening",
    p: "Launch is a checkpoint, not the finish line. Real usage reveals what design reviews can't.",
    take: "Ship, learn, iterate.",
  },
];
---

<section id="process" class="process reveal">
  <img
    class="process-figure"
    src={`${base}/images/sticker-brainstorm-v2.png`}
    alt="Illustration of Aishwarya brainstorming at a whiteboard"
    loading="lazy"
  />
  <div class="process-body">
    <p class="eyebrow">/ how i think</p>
    <h2 class="manifesto">How I approach <em>Design.</em></h2>
    <p class="process-intro">
      I don't see design as a checklist. I see it as a way to make better decisions
      through ambiguity, constraints, and feedback.
    </p>

    <ol class="tenets">
      {tenets.map((t) => (
        <li>
          <p class="tl-num">{t.n}</p>
          <div>
            <h4>{t.h}</h4>
            <p>{t.p}</p>
            <p class="take">{t.take}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process {
    position: relative;
    padding-top: 8rem;
  }
  /* brainstorming sticker on the left of the principles */
  .process-figure { display: none; }
  @media (min-width: 1000px) {
    .process-body { padding-left: 420px; }
    .process-figure {
      display: block;
      position: absolute;
      left: 0;
      top: 58%;
      transform: translateY(-50%);
      width: clamp(320px, 30vw, 420px);
      height: auto;
      filter: drop-shadow(0 22px 32px rgba(20, 40, 70, 0.22));
      animation: float-br 7s ease-in-out infinite;
      pointer-events: none;
    }
    @keyframes float-br {
      0%, 100% { transform: translateY(-50%); }
      50% { transform: translateY(calc(-50% - 12px)); }
    }
  }
  .manifesto {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.9rem, 5vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    max-width: 20ch;
  }
  .manifesto em {
    font-style: italic;
    color: var(--accent);
  }
  .process-intro {
    margin-top: 1.25rem;
    max-width: 48ch;
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .tenets {
    margin: 3.5rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem 3rem;
  }
  .tenets li {
    display: flex;
    gap: 1.1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .tl-num {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--accent);
    line-height: 1.6;
    min-width: 2rem;
  }
  .tenets h4 {
    font-size: 1.2rem;
    letter-spacing: -0.01em;
  }
  .tenets p {
    margin-top: 0.6rem;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.55;
  }
  .tenets .take {
    margin-top: 0.85rem;
    font-family: var(--font-hand);
    font-size: 1.3rem;
    line-height: 1.15;
    color: var(--accent);
  }
  @media (max-width: 720px) {
    .tenets {
      grid-template-columns: 1fr;
    }
  }
</style>
