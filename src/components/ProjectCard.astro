---
interface Props {
  slug: string;
  index: number;
  num: string;
  tag: string;
  title: string;
  lede: string;
  metric: string;
  accent: string;
  cover?: string;
}
const { slug, index, num, tag, title, lede, metric, accent, cover } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/work/${slug}`;
const coverSrc = cover ? `${base}/images/${cover}` : undefined;
// split the metric into items so a small dot can separate them
const metricParts = metric.split(/\s*·\s*|,\s*(?:and\s+)?/).filter(Boolean);
---

<li class="scard" style={`--i:${index}; --accent:${accent}`}>
  <a href={href} class="scard-link" aria-label={`Read the ${title} case study`}>
    <div class="s-visual project-cover" data-project-slug={slug} class:list={{ 'has-cover': Boolean(coverSrc), 'wayfare-cover': slug === 'wayfare', 'tataneu-cover': slug === 'tata-neu-connect', 'termax-cover': slug === 'termax', 'landing-zone-cover': slug === 'landing-zone' }} transition:name={`cover-${slug}`}>
      {coverSrc ? (
        <img src={coverSrc} alt="" loading="lazy" />
      ) : (
        <div class="s-pattern" aria-hidden="true"><span class="s-num-big">{num}</span></div>
      )}
    </div>
    <div class="s-body">
      <p class="s-index">{num}</p>
      <h3 class="s-title">{title}</h3>
      <p class="s-lede">{lede}</p>
      <p class="s-metric">
        {metricParts.map((part, i) => (
          <>{i > 0 && <span class="dot" aria-hidden="true" />}{part}</>
        ))}
      </p>
      <span class="s-read">Read study <span class="arr">→</span></span>
    </div>
  </a>
</li>

<style>
  .scard {
    list-style: none;
    position: sticky;
    /* each card pins a little lower so the ones beneath peek through */
    top: calc(84px + var(--i) * 20px);
    margin-bottom: 2.5rem;
  }
  .scard:last-child { margin-bottom: 1.25rem; }
  .scard-link {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border-radius: 14px;
    /* glassmorphism: translucent fill, blur, soft light edge */
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.62), rgba(255, 255, 255, 0.34));
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    backdrop-filter: blur(18px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.65);
    box-shadow: 0 30px 60px -34px rgba(20, 40, 70, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.7);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }
  :global([data-theme='dark']) .scard-link {
    background: linear-gradient(135deg, rgba(40, 54, 92, 0.58), rgba(24, 33, 58, 0.38));
    border-color: rgba(255, 255, 255, 0.14);
    box-shadow: 0 30px 60px -34px rgba(0, 0, 0, 0.7),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }
  .scard-link:hover {
    box-shadow: 0 40px 80px -34px color-mix(in srgb, var(--accent) 60%, transparent);
  }
  .s-visual {
    aspect-ratio: 16 / 11;
    border-radius: 8px;
    overflow: hidden;
    background: color-mix(in srgb, var(--accent) 16%, var(--card));
  }
  .s-visual.has-cover { aspect-ratio: auto; }
  .s-visual img { width: 100%; height: auto; }
  .s-visual.wayfare-cover { aspect-ratio: 1227 / 720; }
  .s-visual.wayfare-cover img {
    height: 100%;
    object-fit: cover;
    object-position: 34.3% center;
  }
  .s-visual.tataneu-cover {
    position: relative;
    aspect-ratio: 1227 / 720;
  }
  /* Frame x=368..2628, y=8..1334 of the original 2880px slide. */
  .s-visual.tataneu-cover img {
    position: absolute;
    width: 127.43%;
    max-width: none;
    height: auto;
    left: -16.28%;
    top: -0.6%;
  }
  .s-visual.termax-cover { aspect-ratio: 1227 / 720; }
  .s-visual.termax-cover img {
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .s-visual.landing-zone-cover {
    aspect-ratio: 1227 / 720;
  }
  .s-visual.landing-zone-cover img {
    height: 100%;
    object-fit: cover;
  }
  .s-pattern {
    width: 100%; height: 100%;
    display: grid; place-items: center;
    position: relative;
    background: radial-gradient(120% 120% at 18% 15%, color-mix(in srgb, var(--accent) 48%, transparent), transparent 60%),
      radial-gradient(120% 120% at 85% 92%, color-mix(in srgb, var(--accent) 32%, transparent), transparent 55%);
  }
  .s-pattern::after {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(color-mix(in srgb, var(--accent) 42%, transparent) 1px, transparent 1px);
    background-size: 18px 18px;
    opacity: 0.4;
  }
  .s-num-big {
    position: relative;
    font-family: var(--font-serif);
    font-size: clamp(3.5rem, 9vw, 6rem);
    color: color-mix(in srgb, var(--accent) 85%, var(--ink));
  }
  .s-index {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-faint);
    letter-spacing: 0.08em;
  }
  .s-title {
    margin-top: 0.5rem;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.6rem, 3.4vw, 2.6rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .s-lede {
    margin-top: 1rem;
    color: var(--ink-soft);
    font-size: 1.02rem;
    line-height: 1.6;
    max-width: 46ch;
  }
  .s-metric {
    margin-top: 1.1rem;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.78rem;
    line-height: 1.7;
    letter-spacing: 0.12em;
    /* accents are tuned per project; mix toward dark (light theme) or light (dark theme) to keep AA contrast */
    color: color-mix(in srgb, var(--accent) 70%, #0a1428);
    text-transform: uppercase;
  }
  :global([data-theme='dark']) .s-metric,
  :global([data-theme='dark']) .arr {
    color: color-mix(in srgb, var(--accent) 45%, #ffffff);
  }
  .s-metric .dot {
    display: inline-block;
    width: 4px;
    height: 4px;
    margin: 0 0.7em;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.55;
    vertical-align: middle;
  }
  .s-read {
    display: inline-flex;
    gap: 0.4rem;
    margin-top: 1.5rem;
    font-weight: 500;
    color: var(--ink);
  }
  .scard-link:hover .arr { transform: translateX(6px); }
  .arr { transition: transform 0.3s var(--ease); color: color-mix(in srgb, var(--accent) 70%, #0a1428); }

  @media (max-width: 820px) {
    .scard {
      position: static;
      margin-bottom: 1.5rem;
    }
    .scard:last-child { margin-bottom: 0.75rem; }
    .scard-link { grid-template-columns: 1fr; }
  }
</style>
