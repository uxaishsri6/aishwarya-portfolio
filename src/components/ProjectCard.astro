---
interface Props {
  slug: string;
  num: string;
  tag: string;
  title: string;
  lede: string;
  metric: string;
  accent: string;
  cover?: string;
}
const { slug, num, tag, title, lede, metric, accent, cover } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/work/${slug}`;
const coverSrc = cover ? `${base}/images/${cover}` : undefined;
---

<li class="project-card reveal">
  <a href={href} class="card-link" aria-label={`Read the ${title} case study`}>
    <div
      class="p-visual"
      style={`--accent:${accent}`}
      transition:name={`cover-${slug}`}
    >
      {coverSrc ? (
        <img src={coverSrc} alt="" loading="lazy" />
      ) : (
        <div class="p-pattern" aria-hidden="true">
          <span class="p-num">{num}</span>
        </div>
      )}
    </div>
    <div class="p-body">
      <p class="p-tag">{tag}</p>
      <h3>{title}</h3>
      <p class="p-lede">{lede}</p>
      <p class="p-metric">↳ {metric}</p>
      <span class="p-read">Read the study <span class="arr">→</span></span>
    </div>
  </a>
</li>

<style>
  .project-card {
    list-style: none;
  }
  .card-link {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--card);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }
  .card-link:hover {
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
    box-shadow: 0 24px 60px -30px color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .p-visual {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    background: color-mix(in srgb, var(--accent) 16%, var(--card));
  }
  .p-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .p-pattern {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: radial-gradient(
        120% 120% at 20% 15%,
        color-mix(in srgb, var(--accent) 45%, transparent),
        transparent 60%
      ),
      radial-gradient(
        120% 120% at 85% 90%,
        color-mix(in srgb, var(--accent) 30%, transparent),
        transparent 55%
      );
    position: relative;
  }
  .p-pattern::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      color-mix(in srgb, var(--accent) 40%, transparent) 1px,
      transparent 1px
    );
    background-size: 16px 16px;
    opacity: 0.4;
  }
  .p-num {
    position: relative;
    font-family: var(--font-serif);
    font-size: clamp(3rem, 8vw, 5.5rem);
    color: color-mix(in srgb, var(--accent) 85%, var(--ink));
    z-index: 1;
  }
  .p-tag {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
  }
  .p-body h3 {
    margin-top: 0.9rem;
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    line-height: 1.1;
  }
  .p-lede {
    margin-top: 1rem;
    color: var(--ink-soft);
    font-size: 1.02rem;
  }
  .p-metric {
    margin-top: 1rem;
    font-size: 0.95rem;
    color: var(--ink);
  }
  .p-read {
    display: inline-flex;
    gap: 0.4rem;
    margin-top: 1.5rem;
    font-weight: 500;
    color: var(--accent);
  }
  .card-link:hover .arr {
    transform: translateX(6px);
  }
  .arr {
    transition: transform 0.3s var(--ease);
  }
  @media (max-width: 820px) {
    .card-link {
      grid-template-columns: 1fr;
    }
  }
</style>
