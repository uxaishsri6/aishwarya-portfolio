---
// Shared sky decoration layer that spans the whole .sky-world so clouds,
// birds (day) and stars / shooting stars / moon (night) are consistent
// across every section.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// 24 drifting clouds spread down the whole page
const clouds = Array.from({ length: 24 }, (_, i) => ({
  img: i % 2 ? 'cloud-2.png' : 'cloud-1.png',
  top: +(1.5 + i * (97 / 23)).toFixed(1),
  w: 230 + ((i * 57) % 210),
  dur: 100 + ((i * 37) % 85),
  delay: -((i * 53) % 175),
}));

// elegant swallows, gliding across the day sky
const birds = [
  { top: 8, w: 62, dur: 26, delay: -2 },
  { top: 16, w: 46, dur: 33, delay: -14 },
  { top: 27, w: 70, dur: 22, delay: -8 },
  { top: 39, w: 50, dur: 30, delay: -20 },
  { top: 52, w: 60, dur: 25, delay: -5 },
  { top: 66, w: 44, dur: 35, delay: -26 },
  { top: 80, w: 64, dur: 24, delay: -12 },
];

// deterministic scatter of twinkling stars
const stars = Array.from({ length: 44 }, (_, i) => ({
  top: (i * 97) % 100,
  left: (i * 53 + 7) % 100,
  size: 1.5 + ((i * 7) % 3),
  delay: ((i * 13) % 40) / 10,
  dur: 2.4 + ((i * 11) % 22) / 10,
}));

// up to 7 shooting stars, spread down the page, coming from both sides
const shooting = [
  { top: 6, left: 8, dur: 14, delay: 0, dir: 'l' },
  { top: 20, left: 80, dur: 17, delay: 4, dir: 'r' },
  { top: 35, left: 22, dur: 13, delay: 9, dir: 'l' },
  { top: 50, left: 84, dur: 16, delay: 6, dir: 'r' },
  { top: 64, left: 14, dur: 15, delay: 11, dir: 'l' },
  { top: 79, left: 72, dur: 18, delay: 3, dir: 'r' },
  { top: 92, left: 30, dur: 14, delay: 8, dir: 'l' },
];
---

<div class="skyfx" aria-hidden="true">
  <!-- clouds: drift across every section (both themes; dimmed at night) -->
  <div class="fx-clouds">
    {clouds.map((c) => (
      <img
        src={`${base}/images/${c.img}`}
        alt=""
        loading="lazy"
        style={`top:${c.top}%; width:${c.w}px; animation-duration:${c.dur}s; animation-delay:${c.delay}s;`}
      />
    ))}
  </div>

  <!-- birds: day only -->
  <div class="fx-birds">
    {birds.map((b) => (
      <span
        class="bird"
        style={`top:${b.top}%; width:${b.w}px; animation-duration:${b.dur}s; animation-delay:${b.delay}s;`}
      >
        <svg viewBox="0 0 100 62">
          <!-- elegant swallow: swept wings + forked tail -->
          <path class="bird-path" d="M50 31 C 40 12, 22 6, 3 3 C 21 15, 34 23, 47 32 C 45 38, 43 45, 41 53 L50 43 L59 53 C 57 45, 55 38, 53 32 C 66 23, 79 15, 97 3 C 78 6, 60 12, 50 31 Z" />
        </svg>
      </span>
    ))}
  </div>

  <!-- night sky -->
  <div class="fx-stars">
    {stars.map((s) => (
      <span
        class="star"
        style={`top:${s.top}%; left:${s.left}%; width:${s.size}px; height:${s.size}px; animation-delay:${s.delay}s; animation-duration:${s.dur}s;`}
      ></span>
    ))}
  </div>

  <div class="fx-shooting">
    {shooting.map((s) => (
      <span
        class={`shoot ${s.dir}`}
        style={`top:${s.top}%; left:${s.left}%; animation-duration:${s.dur}s; animation-delay:${s.delay}s;`}
      ></span>
    ))}
  </div>

  <!-- celestial body: arcs left(moon)<->right(sun) and morphs on theme toggle -->
  <div class="celestial">
    <div class="orb">
      <div class="fx-sun"></div>
      <div class="fx-moon"></div>
    </div>
  </div>
</div>

<style>
  .skyfx {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  /* ---- clouds ---- */
  .fx-clouds img {
    position: absolute;
    left: -30%;
    height: auto;
    opacity: 0.8;
    filter: blur(1px);
    animation-name: fx-drift;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    will-change: transform;
  }
  :global([data-theme='dark']) .fx-clouds img {
    opacity: 0.13;
    filter: blur(2px) brightness(0.7);
  }
  @keyframes fx-drift {
    from { transform: translateX(0); }
    to { transform: translateX(175vw); }
  }

  /* ---- birds (day only) ---- */
  .fx-birds { position: absolute; inset: 0; }
  :global([data-theme='dark']) .fx-birds { display: none; }
  .bird {
    position: absolute;
    left: -12%;
    color: #2b3f60;
    opacity: 0.85;
    filter: drop-shadow(0 3px 4px rgba(40, 60, 90, 0.18));
    animation-name: fx-fly;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    will-change: transform;
  }
  .bird svg {
    display: block;
    width: 100%;
    height: auto;
    transform-origin: center;
    animation: fx-flap 1.4s ease-in-out infinite alternate;
  }
  .bird .bird-path { fill: currentColor; }
  @keyframes fx-flap {
    from { transform: scaleY(1); }
    to { transform: scaleY(0.66); }
  }
  @keyframes fx-fly {
    0% { transform: translate(0, 0); }
    25% { transform: translate(35vw, -22px); }
    50% { transform: translate(70vw, 10px); }
    75% { transform: translate(105vw, -14px); }
    100% { transform: translate(140vw, 6px); }
  }

  /* ---- twinkling stars (night only) ---- */
  .fx-stars { position: absolute; inset: 0; display: none; }
  :global([data-theme='dark']) .fx-stars { display: block; }
  .star {
    position: absolute;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 6px 1px rgba(255, 255, 255, 0.85);
    animation-name: fx-tw;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }
  @keyframes fx-tw {
    0%, 100% { opacity: 0.15; transform: scale(0.6); }
    50% { opacity: 1; transform: scale(1.35); }
  }

  /* ---- shooting stars (night only) ---- */
  .fx-shooting { position: absolute; inset: 0; display: none; }
  :global([data-theme='dark']) .fx-shooting { display: block; }
  .shoot {
    position: absolute;
    width: 160px;
    height: 2px;
    border-radius: 2px;
    opacity: 0;
    animation-timing-function: ease-in;
    animation-iteration-count: infinite;
    will-change: transform, opacity;
  }
  .shoot::after {
    content: '';
    position: absolute;
    top: -2px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fff;
    animation: fx-sparkle 0.35s ease-in-out infinite alternate;
  }
  @keyframes fx-sparkle {
    from { box-shadow: 0 0 6px 2px rgba(255, 255, 255, 0.7); }
    to { box-shadow: 0 0 15px 5px rgba(255, 255, 255, 1); }
  }
  /* left → right */
  .shoot.l {
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.95));
    animation-name: fx-shoot-l;
  }
  .shoot.l::after { right: -2px; }
  @keyframes fx-shoot-l {
    0% { opacity: 0; transform: rotate(20deg) translate(-20px, -20px); }
    3% { opacity: 1; }
    16% { opacity: 1; }
    26% { opacity: 0; transform: rotate(20deg) translate(680px, 248px); }
    100% { opacity: 0; transform: rotate(20deg) translate(680px, 248px); }
  }
  /* right → left */
  .shoot.r {
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.95), transparent);
    animation-name: fx-shoot-r;
  }
  .shoot.r::after { left: -2px; }
  @keyframes fx-shoot-r {
    0% { opacity: 0; transform: rotate(-20deg) translate(20px, -20px); }
    3% { opacity: 1; }
    16% { opacity: 1; }
    26% { opacity: 0; transform: rotate(-20deg) translate(-680px, 248px); }
    100% { opacity: 0; transform: rotate(-20deg) translate(-680px, 248px); }
  }

  /* ---- celestial body: arcs across the sky on theme toggle ---- */
  .celestial {
    position: absolute;
    top: 30px;
    left: 50%;
    width: 1300px;
    height: 190px;
    transform: translateX(-50%);
    transform-origin: top center;
  }
  .orb {
    position: absolute;
    width: 104px;
    height: 104px;
    /* wide, shallow arc: far-left(moon) -> up-over -> far-right(sun) */
    offset-path: path('M 20 96 A 630 74 0 0 1 1280 96');
    offset-anchor: 50% 50%;
    offset-rotate: 0deg;
    offset-distance: 100%;           /* light: sun rests on the right */
    transition: offset-distance 1.5s cubic-bezier(0.5, 0, 0.3, 1);
    will-change: offset-distance;
  }
  :global([data-theme='dark']) .orb {
    offset-distance: 0%;             /* dark: moon rests on the left */
  }
  .fx-sun,
  .fx-moon {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    transition: opacity 1.4s ease;
    will-change: opacity;
  }

  /* sun */
  .fx-sun {
    background: radial-gradient(circle at 42% 38%, #fff6c4 0%, #ffd54a 52%, #ffb020 100%);
    box-shadow:
      0 0 40px 10px rgba(255, 198, 84, 0.6),
      0 0 90px 34px rgba(255, 186, 70, 0.28);
    opacity: 1;
  }
  .fx-sun::before {
    content: '';
    position: absolute;
    inset: -42%;
    border-radius: 50%;
    background: repeating-conic-gradient(
      from 0deg,
      rgba(255, 200, 84, 0.6) 0deg 5deg,
      transparent 5deg 17deg
    );
    -webkit-mask: radial-gradient(circle, transparent 50%, #000 53%, #000 66%, transparent 71%);
    mask: radial-gradient(circle, transparent 50%, #000 53%, #000 66%, transparent 71%);
    animation: fx-spin 44s linear infinite;
  }
  @keyframes fx-spin {
    to { transform: rotate(360deg); }
  }

  /* realistic moon */
  .fx-moon {
    opacity: 0;
    background:
      radial-gradient(circle at 30% 38%, rgba(150, 142, 120, 0.45) 0 7px, transparent 8px),
      radial-gradient(circle at 60% 30%, rgba(150, 142, 120, 0.35) 0 5px, transparent 6px),
      radial-gradient(circle at 66% 58%, rgba(150, 142, 120, 0.4) 0 10px, transparent 11px),
      radial-gradient(circle at 44% 70%, rgba(150, 142, 120, 0.32) 0 6px, transparent 7px),
      radial-gradient(circle at 26% 60%, rgba(150, 142, 120, 0.3) 0 4px, transparent 5px),
      radial-gradient(circle at 38% 34%, #fdfcf5 0%, #efe9d6 45%, #d9d1ba 72%, #beb69d 100%);
    box-shadow:
      inset -20px -16px 34px rgba(90, 82, 64, 0.4),
      inset 8px 8px 18px rgba(255, 253, 245, 0.5),
      0 0 60px 12px rgba(244, 241, 230, 0.28);
  }

  /* dark theme: fade out sun, fade in moon (orb travels the arc) */
  :global([data-theme='dark']) .fx-sun { opacity: 0; }
  :global([data-theme='dark']) .fx-moon { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .fx-clouds img, .bird, .bird svg, .star, .shoot, .shoot::after, .fx-sun::before {
      animation: none !important;
    }
    .orb { transition: none; }
    .fx-shooting { display: none; }
  }
  /* scale the wide arc to fit narrower viewports (stays centered) */
  @media (max-width: 1360px) {
    .celestial { transform: translateX(-50%) scale(0.85); }
  }
  @media (max-width: 1100px) {
    .celestial { transform: translateX(-50%) scale(0.66); }
  }
  @media (max-width: 760px) {
    .celestial { transform: translateX(-50%) scale(0.5); top: 22px; }
  }
</style>
