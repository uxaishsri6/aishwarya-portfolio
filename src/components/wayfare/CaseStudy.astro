---
// Wayfare — presented as the original case-study deck (static images).
// The 16 exported section frames are shown as one continuous, responsive page.
// (A dynamic, natively-rebuilt version is preserved on the `wayfare-dynamic` branch.)
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const labels: Record<string, string> = {
  '01': 'Cover',
  '02': 'Problem & Background',
  '03': 'My design process',
  '04': 'Research & method',
  '05': 'Meet the travellers',
  '06': 'Key insights',
  '07': 'Competitive landscape',
  '08': 'IA & user journey',
  '09': 'Wireframes',
  '10': 'Design decisions',
  '11': 'Design system',
  '12': 'Hi-fidelity designs',
  '13': 'Hi-fi other screens',
  '14': 'Prototype',
  '15': 'Validation & iteration',
  '16': 'Reflection',
};
const slides = Object.keys(labels).sort();
---

<div class="wf-deck">
  {slides.map((n, i) => (
    <figure class="wf-slide">
      <img
        src={`${base}/images/wayfare/slide-${n}.png`}
        alt={`Wayfare, ${labels[n]}`}
        loading={i === 0 ? 'eager' : 'lazy'}
        decoding="async"
      />
    </figure>
  ))}
</div>

<style>
  .wf-deck {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
  }
  .wf-slide {
    margin: 0;
    width: 100%;
  }
  .wf-slide img {
    width: 100%;
    height: auto;
    display: block;
    /* butt slides together so it reads as one continuous page */
    margin: 0 0 -1px;
  }
</style>
