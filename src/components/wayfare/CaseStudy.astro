---
// Wayfare — presented as the original case-study deck (static images).
// The 16 exported section frames are shown as one continuous, responsive page.
// (A dynamic, natively-rebuilt version is preserved on the `wayfare-dynamic` branch.)
import CaseStudyDeck from '../CaseStudyDeck.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const labels: Record<string, string> = {
  '01': 'Cover',
  '02': 'Problem & Background',
  '03': 'My design process',
  '04': 'Research & method',
  '05': 'Meet the travellers',
  '06': 'Key insights',
  '07': 'Competitive landscape',
  '08': 'IA & user journey',
  '09': 'Wireframes',
  '10': 'Design decisions',
  '11': 'Design system',
  '12': 'Hi-fidelity designs',
  '13': 'Hi-fi other screens',
  '14': 'Prototype',
  '15': 'Validation & iteration',
  '16': 'Reflection',
};
const slides = Object.keys(labels).sort().map((n) => ({
  src: `${base}/images/wayfare/slide-${n}.png`,
  alt: `Wayfare, ${labels[n]}`,
}));
---

<CaseStudyDeck slug="wayfare" slides={slides} />
