---
// Competitive — Section 06 of the Wayfare case study.
// A capability comparison table plus a Myra vs Wayfare breakdown.
const cols = ['Google Flights', 'Skyscanner', 'Kiwi.com', 'MakeMyTrip', 'Ours'];
// cell values: 'full' = ✓, 'partial' = ~, 'none' = ✕   order matches cols above
const rows = [
  { cap: 'Self-assembled multi-airline routes', cells: ['none', 'partial', 'full', 'none', 'full'] },
  { cap: 'Explains self-transfer risk in plain words', cells: ['none', 'none', 'partial', 'none', 'full'] },
  { cap: 'Missed-connection safety net', cells: ['none', 'none', 'partial', 'none', 'full'] },
  { cap: 'Trade-offs legible: time / cost / layover', cells: ['partial', 'partial', 'none', 'none', 'full'] },
  { cap: `AI reasoning, “why this route”`, cells: ['none', 'none', 'none', 'none', 'full'] },
  { cap: 'Human stays in control of booking', cells: ['full', 'full', 'full', 'full', 'full'] },
];
const glyph: Record<string, string> = { full: '✓', partial: '~', none: '✕' };

const myra = [
  { cap: 'Inventory', myra: `Books MakeMyTrip’s own inventory`, wf: 'Cross-provider, assembles multi-airline routes the big sites hide' },
  { cap: 'Booking', myra: 'Locked to one OTA', wf: 'Per-leg provider choice, you pick who books each leg' },
  { cap: 'Output', myra: 'A conversational answer', wf: `Legible trade-offs + “why this route” with sources` },
  { cap: 'Self-transfer risk', myra: 'Not surfaced', wf: `Honest risk in plain words + a “what if I miss it” safety net` },
  { cap: 'Control', myra: 'AI-led booking funnel', wf: 'AI ⇄ Manual toggle; you confirm before booking' },
];
---
<section class="wf-section competitive">
  <div class="wf-wrap">
    <p class="wf-eyebrow">06 · COMPETITIVE LANDSCAPE</p>
    <h2 class="wf-h2">Every big site stops short of a self-assembled route.</h2>
    <p class="wf-intro">The gap we fill: assemble the route, explain the risk in plain language, and keep the traveller in control of the booking.</p>

    <div class="scroll">
      <table class="cmp">
        <thead>
          <tr>
            <th scope="col" class="cap-h">CAPABILITY</th>
            {cols.map((c) => (
              <th scope="col" class={c === 'Ours' ? 'ours-h' : ''}>{c}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <th scope="row" class="cap">{r.cap}</th>
              {r.cells.map((v, i) => (
                <td class={`c-${v}${cols[i] === 'Ours' ? ' ours' : ''}`}>
                  <span class="g">{glyph[v]}</span>
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="legend">
      <span class="c-full">✓</span> full
      <span class="c-partial">~</span> partial
      <span class="c-none">✕</span> not offered
    </p>

    <div class="myra-block">
      <p class="wf-kicker">HOW WE IMPROVE ON MYRA (MAKEMYTRIP’S AI ASSISTANT)</p>
      <p class="myra-intro">Myra is an excellent in-app concierge, but it sells one OTA’s inventory. Our edge is assembling across providers and staying honest about risk.</p>

      <div class="scroll">
        <table class="myra">
          <thead>
            <tr>
              <th scope="col" class="corner"></th>
              <th scope="col" class="myra-h">Myra</th>
              <th scope="col" class="wf-h">Wayfare</th>
            </tr>
          </thead>
          <tbody>
            {myra.map((m) => (
              <tr>
                <th scope="row" class="mcap">{m.cap}</th>
                <td class="mval">{m.myra}</td>
                <td class="wval">{m.wf}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<style>
  .scroll {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    overflow-x: auto;
    border-radius: 14px;
    border: 1px solid var(--wf-border);
  }
  table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    text-align: left;
  }

  /* ---- Capability comparison ---- */
  .cmp thead th {
    background: var(--wf-text);
    color: var(--wf-bg);
    font-size: 0.9rem;
    font-weight: 700;
    padding: 1rem 1.1rem;
    text-align: center;
    white-space: nowrap;
  }
  .cmp .cap-h {
    text-align: left;
    font-size: 0.78rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--wf-text-faint);
  }
  .cmp .ours-h {
    background: var(--wf-primary);
    color: var(--wf-on-primary);
  }
  .cmp tbody tr:nth-child(even) { background: var(--wf-surface-muted); }
  .cmp tbody tr:nth-child(odd) { background: var(--wf-surface); }
  .cmp .cap {
    font-weight: 600;
    color: var(--wf-text);
    padding: 1rem 1.1rem;
    font-size: 0.98rem;
  }
  .cmp td {
    text-align: center;
    padding: 1rem 1.1rem;
    font-size: 1.1rem;
  }
  .cmp td.ours { background: var(--wf-primary-tint); }
  .g { font-weight: 700; }
  .c-full .g, .c-full { color: var(--wf-success); }
  .c-partial .g, .c-partial { color: var(--wf-warn); }
  .c-none .g, .c-none { color: var(--wf-text-faint); }

  .legend {
    margin: 1rem 0 0;
    font-size: 0.9rem;
    color: var(--wf-text-muted);
  }
  .legend span { font-weight: 700; margin-right: 0.15rem; }
  .legend span:not(:first-child) { margin-left: 1rem; }

  /* ---- Myra vs Wayfare ---- */
  .myra-block { margin-top: clamp(3rem, 6vw, 4.5rem); }
  .myra-intro {
    margin: 0 0 0.5rem;
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.6;
    color: var(--wf-text-muted);
    max-width: 78ch;
  }
  .myra thead th {
    padding: 0.9rem 1.25rem;
    font-size: 0.98rem;
    font-weight: 700;
  }
  .myra .corner { background: var(--wf-text); width: 22%; }
  .myra .myra-h {
    background: var(--wf-text);
    color: var(--wf-text-muted);
  }
  .myra .wf-h {
    background: var(--wf-primary);
    color: var(--wf-on-primary);
  }
  .myra tbody tr:nth-child(even) { background: var(--wf-surface-muted); }
  .myra tbody tr:nth-child(odd) { background: var(--wf-surface); }
  .myra .mcap {
    padding: 1rem 1.25rem;
    font-weight: 700;
    color: var(--wf-text);
    font-size: 0.98rem;
    white-space: nowrap;
  }
  .myra .mval {
    padding: 1rem 1.25rem;
    color: var(--wf-text-muted);
    font-size: 0.98rem;
  }
  .myra .wval {
    padding: 1rem 1.25rem;
    color: var(--wf-text);
    font-size: 0.98rem;
    background: var(--wf-primary-tint);
  }

  @media (max-width: 640px) {
    .legend span:not(:first-child) { margin-left: 0.6rem; }
  }
</style>
