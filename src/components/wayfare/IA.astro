---
// IA — Section 07 of the Wayfare case study
// Information Architecture & User Journey

// ---- Part 1: App map (information architecture) ----
type Group = { title: string; badge?: string; items: string[] };
type Column = { key: string; icon: string; name: string; groups: Group[] };

const columns: Column[] = [
  {
    key: 'home',
    icon: '⌂',
    name: 'Home',
    groups: [
      {
        title: 'Assistant',
        badge: 'MODE',
        items: [
          'Conversational intake',
          'Live deliberation + results',
          'Voice input (live transcription)',
          'Document upload · reads your itinerary',
        ],
      },
      {
        title: 'Manual',
        badge: 'MODE',
        items: [
          'Search form (from · to · dates · pax)',
          'Filters (price · stops · time · airline · self-transfer)',
          'Results list',
        ],
      },
      {
        title: 'Route Results',
        items: ['AI pick, smart route', 'Standard options'],
      },
      {
        title: 'Route Detail',
        items: [
          'Trade-offs (time · cost · layover)',
          'Why this route (reasoning + sources)',
          'Self-transfer risk · confidence · baggage · safety net',
          'Per-leg providers',
        ],
      },
      {
        title: 'Booking hand-off',
        items: ['Confirm each leg', 'Payment (per leg)', 'Confirmed + backup saved'],
      },
    ],
  },
  {
    key: 'trips',
    icon: '⟋',
    name: 'Trips',
    groups: [
      {
        title: 'Upcoming',
        items: ['Trip detail (itinerary + legs)', 'Day-of guidance', 'Missed-connection assist'],
      },
      {
        title: 'Past trips',
        items: ['Trip archive', 'Receipts & invoices'],
      },
      {
        title: 'Saved',
        items: ['Saved smart routes', 'Price-watch'],
      },
    ],
  },
  {
    key: 'profile',
    icon: '◉',
    name: 'Profile',
    groups: [
      {
        title: 'Travellers & documents',
        items: ['Co-travellers', 'Documents (passport · visa)'],
      },
      {
        title: 'Insights',
        items: ['Price watch', 'Travel spend'],
      },
      {
        title: 'Settings ▸',
        items: [
          'AI settings · automation, sources',
          'Preferences & rules',
          'Notifications',
          'Payment methods',
          'Appearance · light / dark',
          'Help & support',
        ],
      },
    ],
  },
];

// ---- Part 2: User journey / the anxiety curve ----
// emotion → tone maps across the 7 stages
type Stage = {
  num: string;
  name: string;
  emotion: string;
  tone: 'calm' | 'wary' | 'peak';
  does: string;
  response: string;
};

const stages: Stage[] = [
  { num: '1', name: 'Trigger', emotion: 'Calm', tone: 'calm', does: 'Needs to book a long, complex trip', response: 'Warm, simple start' },
  { num: '2', name: 'Search', emotion: 'Curious', tone: 'calm', does: 'Opens the usual booking sites', response: 'Assistant offers to find smarter routes' },
  { num: '3', name: 'Glimpse', emotion: 'Wary', tone: 'wary', does: 'Spots a cheaper self-transfer', response: 'Reveal: smart route vs standard, side by side' },
  { num: '4', name: 'Weigh', emotion: 'Confused', tone: 'wary', does: 'Trade-offs are hard to compare', response: 'One clear comparison, why it wins' },
  { num: '5', name: 'Risk', emotion: 'Peak fear', tone: 'peak', does: '“What if I miss the 2nd flight?”', response: 'Plain-language risk + a safety-net plan' },
  { num: '6', name: 'Decide', emotion: 'Tense', tone: 'wary', does: 'Needs reassurance to commit', response: 'Reasoning shown; the human confirms' },
  { num: '7', name: 'Book & go', emotion: 'Relieved', tone: 'calm', does: 'Wants a safety net in pocket', response: 'Per-leg booking + saved backup plan' },
];

// curve geometry: rises to Peak fear (stage 5), then relaxes to Relieved
const cx = [50, 150, 250, 350, 450, 550, 650];
const cy = [92, 76, 56, 46, 22, 56, 82];
const points = cx.map((x, i) => `${x},${cy[i]}`).join(' ');
---

<section class="wf-section ia">
  <div class="wf-wrap">
    <p class="wf-eyebrow">07 · Information Architecture &amp; User Journey</p>
    <h2 class="wf-h2">From priorities to booking.</h2>
    <p class="wf-intro">
      A single spine, an AI intake that leads to a reveal, a decision and a confident booking hand-off,
      inside a familiar Home · Trips · Profile shell. The full app map:
    </p>

    <!-- Part 1: App map -->
    <p class="wf-kicker ia-kicker">App map · Information architecture</p>
    <div class="ia-map">
      {columns.map((col) => (
        <div class={`ia-col ia-col-${col.key}`}>
          <div class={`ia-head ia-head-${col.key}`}>
            <span class="ia-head-icon" aria-hidden="true">{col.icon}</span>
            <span class="ia-head-name">{col.name}</span>
          </div>
          <div class="ia-groups">
            {col.groups.map((g) => (
              <article class="ia-card">
                <p class="ia-card-title">
                  <span>{g.title}</span>
                  {g.badge && <span class="ia-badge">{g.badge}</span>}
                </p>
                <ul class="ia-list">
                  {g.items.map((it) => (
                    <li>{it}</li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Part 2: User journey / anxiety curve -->
    <p class="wf-kicker ia-kicker ia-kicker-journey">User journey · The anxiety curve</p>

    <div class="ia-curve" aria-hidden="true">
      <svg viewBox="0 0 700 120" preserveAspectRatio="none" class="ia-curve-svg" role="presentation">
        <polyline
          points={points}
          fill="none"
          stroke="var(--wf-primary)"
          stroke-width="2.5"
          stroke-linejoin="round"
          stroke-linecap="round"
          vector-effect="non-scaling-stroke"
        />
        {cx.map((x, i) => (
          <circle
            cx={x}
            cy={cy[i]}
            r={stages[i].tone === 'peak' ? 6 : 4}
            fill={stages[i].tone === 'peak' ? 'var(--wf-danger)' : 'var(--wf-primary)'}
          />
        ))}
      </svg>
    </div>

    <ol class="ia-journey">
      {stages.map((s) => (
        <li class={`ia-step ia-tone-${s.tone}`}>
          <span class="ia-step-num">{s.num}</span>
          <p class="ia-step-name">{s.name}</p>
          <span class={`ia-emotion ia-tone-${s.tone}`}>{s.emotion}</span>
          <p class="ia-step-does">{s.does}</p>
          <p class="ia-step-resp-label">Our response</p>
          <p class="ia-step-resp">{s.response}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .ia-kicker {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  .ia-kicker-journey {
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  /* ---- Part 1: App map ---- */
  .ia-map {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
    align-items: start;
  }
  .ia-col {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .ia-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 1.1rem;
    border-radius: 12px;
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--wf-on-primary);
    background: var(--wf-primary);
  }
  .ia-head-profile {
    background: var(--wf-indigo);
  }
  .ia-head-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.18);
    font-size: 0.95rem;
    line-height: 1;
  }
  .ia-groups {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  /* Home column is the spine, subtly tinted */
  .ia-col-home .ia-card {
    background: var(--wf-primary-tint);
    border-color: color-mix(in srgb, var(--wf-primary) 22%, transparent);
  }
  .ia-card {
    border: 1px solid var(--wf-border);
    border-radius: 14px;
    background: var(--wf-surface);
    padding: 1.1rem 1.2rem;
  }
  .ia-card-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin: 0 0 0.7rem;
    font-weight: 700;
    font-size: 1rem;
    color: var(--wf-text);
  }
  .ia-badge {
    flex: none;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--wf-primary-text);
    background: var(--wf-primary-tint);
    border: 1px solid color-mix(in srgb, var(--wf-primary) 25%, transparent);
    padding: 0.2rem 0.45rem;
    border-radius: 6px;
  }
  .ia-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .ia-list li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--wf-text-muted);
  }
  .ia-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--wf-primary);
  }

  /* ---- Part 2: Anxiety curve ---- */
  .ia-curve {
    border: 1px solid var(--wf-border);
    border-radius: 16px;
    background: var(--wf-surface-muted);
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
  }
  .ia-curve-svg {
    display: block;
    width: 100%;
    height: 110px;
  }

  .ia-journey {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: clamp(0.75rem, 1.4vw, 1.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ia-step {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .ia-step-num {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--wf-primary-text);
  }
  .ia-step-name {
    margin: 0.1rem 0 0.2rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--wf-text);
  }
  .ia-emotion {
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    margin-bottom: 0.3rem;
  }
  .ia-tone-calm .ia-emotion {
    color: var(--wf-success);
    background: var(--wf-success-tint);
  }
  .ia-tone-wary .ia-emotion {
    color: var(--wf-warn);
    background: var(--wf-warn-tint);
  }
  .ia-tone-peak .ia-emotion {
    color: var(--wf-danger);
    background: var(--wf-danger-tint);
  }
  .ia-step-does {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--wf-text-muted);
  }
  .ia-step-resp-label {
    margin: 0.65rem 0 0.15rem;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--wf-text-faint);
  }
  .ia-step-resp {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.45;
    font-weight: 600;
    color: var(--wf-text);
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .ia-map {
      grid-template-columns: 1fr;
    }
    .ia-journey {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .ia-step {
      border: 1px solid var(--wf-border);
      border-radius: 12px;
      background: var(--wf-surface);
      padding: 1rem 1.1rem;
    }
    .ia-curve {
      display: none;
    }
  }
</style>
