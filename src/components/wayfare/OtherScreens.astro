---
// 10b — Hi-Fi Other Screens (light & dark). Real 2x phone crops.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (n: string) => `${base}/images/wayfare/s10b-${n}.png`;

type Phone = [string, string];
const lightRows: Phone[][] = [
  [['onb1', 'Onboarding 1'], ['onb2', 'Onboarding 2'], ['onb3', 'Onboarding 3'], ['create-account', 'Create account']],
  [['signin', 'Sign in'], ['trips', 'Trips'], ['profile', 'Profile'], ['settings', 'Settings']],
];
const darkRows: Phone[][] = [
  [['reveal-d', 'Reveal'], ['safety-d', 'Self-transfer safety'], ['why-d', 'Why this route'], ['seat-d', 'Choose seat'], ['payment-d', 'Payment']],
  [['confirmed-d', 'Booking confirmed'], ['boarding-d', 'Boarding pass'], ['trip-details-d', 'Trip details'], ['confirm-d', 'Confirm'], ['ai-reads-d', 'AI reads document']],
];
---

<section class="wf-section other">
  <div class="wf-wrap">
    <p class="wf-eyebrow">10 · Hi-Fidelity Designs</p>
    <h2 class="wf-h2">Other screens, in light & dark.</h2>
    <p class="wf-intro">Full breadth of the product, in both themes. Light rows below cover onboarding and account; dark rows show the booking core.</p>

    <p class="wf-kicker band-kick">Light · onboarding & account</p>
    {lightRows.map((row) => (
      <div class="os-row" data-count={row.length}>
        {row.map(([n, cap]) => (
          <figure class="phone-fig">
            <img src={img(n)} alt={`Wayfare screen: ${cap}`} width="188" height="406" loading="lazy" />
            <figcaption>{cap}</figcaption>
          </figure>
        ))}
      </div>
    ))}

    <p class="wf-kicker band-kick dark-kick">Dark · booking core</p>
    {darkRows.map((row) => (
      <div class="os-row" data-count={row.length}>
        {row.map(([n, cap]) => (
          <figure class="phone-fig">
            <img src={img(n)} alt={`Wayfare screen (dark): ${cap}`} width="188" height="406" loading="lazy" />
            <figcaption>{cap}</figcaption>
          </figure>
        ))}
      </div>
    ))}
  </div>
</section>

<style>
  .band-kick { margin-top: 2.75rem; }
  .os-row {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.75rem, 1.6vw, 1.4rem);
    margin-top: 1.25rem;
  }
  .phone-fig { flex: 1 1 150px; max-width: 200px; margin: 0; }
  .phone-fig img {
    width: 100%;
    height: auto;
    border-radius: 1.4rem;
    box-shadow: 0 18px 40px -22px rgba(15, 30, 60, 0.4);
    background: var(--wf-surface);
  }
  :global([data-theme='dark']) .phone-fig img {
    box-shadow: 0 18px 44px -20px rgba(0, 0, 0, 0.7);
  }
  .phone-fig figcaption {
    margin-top: 0.7rem;
    text-align: center;
    font-size: 0.8rem;
    color: var(--wf-text-muted);
  }
  @media (max-width: 900px) {
    .os-row { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 0.75rem; -webkit-overflow-scrolling: touch; }
    .phone-fig { flex: 0 0 44%; max-width: 44%; }
  }
  @media (max-width: 560px) {
    .phone-fig { flex-basis: 60%; max-width: 60%; }
  }
</style>
