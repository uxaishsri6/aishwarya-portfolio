---
// Travellers — Section 04b of the Wayfare case study.
// "Meet the Travellers": four personas, each a different posture toward trust.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const personas = [
  {
    name: 'Aisha M.',
    img: 'aisha',
    tag: 'INTERVIEW',
    age: 'Age 33',
    label: 'The Anxious International',
    booksVia: 'MakeMyTrip, airline sites',
    keyNeed: `“What if the first flight is late and I miss the second one?” Needs a visible safety net before she’ll trust an unconventional route.`,
    kind: 'danger',
  },
  {
    name: 'Niraj K.',
    img: 'niraj',
    tag: 'SURVEY',
    age: 'Age 29',
    label: 'The Power Optimizer',
    booksVia: 'Google Flights, Skyscanner, Kiwi, MMT',
    keyNeed: `“AI might chase price and miss baggage, layovers, timings.” Wants faster search, and its reasoning shown before he commits.`,
    kind: 'success',
  },
  {
    name: 'Prakash R.',
    img: 'prakash',
    tag: 'SURVEY',
    age: 'Age 41',
    label: 'The Family Planner',
    booksVia: 'Skyscanner, MakeMyTrip, airline sites',
    keyNeed: `Books for parents & family, so control is everything: “Notify me, I’ll decide every time. Never book without my confirmation.”`,
    kind: 'primary',
  },
  {
    name: 'Suman S.',
    img: 'suman',
    tag: 'SURVEY',
    age: 'Age 35',
    label: 'The Refund-Burned Skeptic',
    booksVia: 'Amazon, airline sites',
    keyNeed: `Once got burned on a refund. Wants the app to handle the rebooking mess, and: “Never act automatically, only suggest.”`,
    kind: 'indigo',
  },
];
---
<section class="wf-section travellers">
  <div class="wf-wrap">
    <p class="wf-eyebrow">USER RESEARCH · MEET THE TRAVELLERS</p>
    <h2 class="wf-h2">Four travellers, four postures toward trust.</h2>
    <p class="wf-intro">Personas grounded in real survey respondents and interviewees, from the anxious first-timer to the power optimizer. Together they span the spectrum the design must serve.</p>

    <div class="grid">
      {personas.map((p) => (
        <article class={`card p-${p.kind}`}>
          <img class="avatar" src={`${base}/images/wayfare/persona-${p.img}.png`} alt={`Illustration of persona ${p.name}, ${p.label}`} width="116" height="144" loading="lazy" />
          <div class="body">
            <header class="top">
              <h3 class="name">{p.name}</h3>
              <span class="tag">{p.tag}</span>
            </header>
            <p class="age">{p.age}</p>
            <p class="label">{p.label}</p>
            <div class="meta">
              <p class="mlabel">BOOKS VIA</p>
              <p class="mval">{p.booksVia}</p>
              <p class="mlabel">KEY NEED / FEAR</p>
              <p class="need">{p.keyNeed}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    margin-top: clamp(2rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .card {
    display: flex;
    gap: 1.25rem;
    border: 1px solid var(--wf-border);
    border-radius: 16px;
    background: var(--wf-surface-muted);
    padding: 1.5rem;
  }
  .p-danger { --accent: var(--wf-danger); --tint: var(--wf-danger-tint); }
  .p-success { --accent: var(--wf-success); --tint: var(--wf-success-tint); }
  .p-primary { --accent: var(--wf-primary-text); --tint: var(--wf-primary-tint); }
  .p-indigo { --accent: var(--wf-indigo); --tint: var(--wf-indigo); }
  .avatar {
    flex: 0 0 auto;
    width: clamp(92px, 11vw, 116px);
    height: auto;
    aspect-ratio: 116 / 144;
    object-fit: cover;
    border-radius: 14px;
    display: block;
  }
  .body { flex: 1 1 auto; min-width: 0; }
  .top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .name {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--wf-text);
  }
  .tag {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--wf-text-faint);
    white-space: nowrap;
  }
  .age {
    margin: 0.35rem 0 0;
    font-size: 0.95rem;
    color: var(--wf-text-muted);
  }
  .label {
    margin: 0.5rem 0 0;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--wf-primary-text);
  }
  .meta {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--wf-border);
  }
  .mlabel {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--wf-danger);
  }
  .mval {
    margin: 0.3rem 0 0;
    font-size: 0.98rem;
    color: var(--wf-text);
  }
  .need {
    margin: 0.3rem 0 0;
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--wf-text);
  }
  .meta .mlabel + .mval + .mlabel { margin-top: 0.9rem; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .card { flex-direction: column; }
  }
</style>
