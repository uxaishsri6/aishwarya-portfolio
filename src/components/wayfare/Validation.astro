---
// 12 — Validation & Iteration (live Figma: Maze benchmark v1 -> v2).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const tiles = [
  ['14', 'participants, unmoderated, across all four persona segments'],
  ['5', 'missions: plan, judge the self-transfer, book & pay, see the why, get the pass'],
  ['Maze', 'unmoderated remote test, task success and misclicks tracked'],
  ['v1 → v2', 'same missions run on the first and current designs'],
];

const metrics = [
  ['Usability score', '84', 'from 62', '▲ +22', 'up'],
  ['Task completion', '93%', 'from 61%', '▲ +32 pts', 'up'],
  ['Misclicks / task', '1.2', 'from 3.8', '▼ −68%', 'down'],
  ['Avg time / task', '42s', 'from 71s', '▼ −41%', 'down'],
  ['SUS score', '86', 'from 69', '▲ +17', 'up'],
];

const missions = [
  ['1 · Plan with the assistant', 86, 100],
  ['2 · Judge if the self-transfer is safe', 50, 93],
  ['3 · Book & pay', 57, 93],
  ['4 · Understand why this route', 43, 86],
  ['5 · Retrieve boarding pass', 71, 93],
] as [string, number, number][];
---

<section class="wf-section valid">
  <div class="wf-wrap">
    <p class="wf-eyebrow">12 · Validation & Iteration</p>
    <h2 class="wf-h2">Tested against real friction and shipped what the data asked for.</h2>
    <p class="wf-intro">An unmoderated Maze benchmark: 14 participants ran the same five missions on both the first design and the current one, across all four persona segments. The gap between the two versions is the story, and it points straight at three fixes.</p>

    <p class="wf-kicker">How we tested · Maze benchmark</p>
    <div class="tiles">
      {tiles.map(([n, cap]) => (
        <article class="tile">
          <p class="tile-n">{n}</p>
          <p class="tile-cap">{cap}</p>
        </article>
      ))}
    </div>

    <p class="wf-kicker res-kick">Maze results · before → after</p>
    <div class="metrics">
      {metrics.map(([label, big, from, delta, dir]) => (
        <article class="metric">
          <p class="m-label">{label}</p>
          <p class="m-big">{big}</p>
          <p class="m-foot"><span class="m-from">{from}</span> <span class={`m-delta ${dir}`}>{delta}</span></p>
        </article>
      ))}
    </div>

    <div class="chart">
      <div class="chart-head">
        <h3 class="chart-title">Task success by mission</h3>
        <div class="legend"><span class="lg lg-v1">v1</span><span class="lg lg-cur">current</span></div>
      </div>
      {missions.map(([name, v1, cur]) => (
        <div class="bar-row">
          <span class="bar-name">{name}</span>
          <span class="bar-track">
            <span class="bar-v1" style={`width:${v1}%`}></span>
            <span class="bar-gain" style={`width:${cur - v1}%`}></span>
          </span>
          <span class="bar-nums">{v1}% <span class="arrow">→</span> <b>{cur}%</b></span>
        </div>
      ))}
    </div>

    <p class="wf-kicker report-kick">Maze report · expected path · Mission 4 (why this route)</p>
    <figure class="report">
      <img src={`${base}/images/wayfare/maze-report.png`} alt="Maze expected-path report for Mission 4: per-screen usability scores, success and drop-off metrics, and a misclick heatmap over the Reveal screen." width="1248" height="1988" loading="lazy" />
    </figure>

    <p class="wf-kicker">Findings & fixes</p>
    <p class="findings-intro">Three changes came out of testing. Each traces back to something a participant said, and to what the survey already hinted at.</p>

    <div class="fixes">
      <!-- FIX 1 -->
      <article class="fix">
        <header class="fix-head">
          <span class="sev high">High</span>
          <h3 class="fix-title">Our first risk cue scared people off</h3>
          <span class="fix-mission">Mission 2 · 50% → 93% success</span>
        </header>
        <div class="fix-grid">
          <div class="ba">
            <span class="ba-tag before">Before</span>
            <div class="mock">
              <div class="mock-row"><b>DEL → DXB → LHR</b><span>₹31,400</span></div>
              <div class="mock-box danger"><b>⚠ Self-transfer · higher risk</b><span>72% on-time · you connect yourself</span></div>
              <p class="mock-note">A cold stat + a red flag, no reassurance</p>
            </div>
          </div>
          <div class="ba">
            <span class="ba-tag after">After</span>
            <div class="mock">
              <div class="mock-row"><b>Is this connection safe?</b><span class="pill success">High</span></div>
              <p class="mock-check">✓ Same terminal (T3), no re-check</p>
              <div class="mock-box warn"><b>What if I miss it?</b><span>Add missed-connection cover · ₹499</span></div>
            </div>
          </div>
          <div class="changed">
            <p class="changed-label">What we changed</p>
            <p class="changed-body">Research told us to de-risk self-transfer, and v1 did flag it, but a red "higher risk" label and a bare on-time percentage made people more anxious, not less. We reframed it as a plain-language confidence card with a concrete what-if-I-miss-it safety net.</p>
            <blockquote class="quote">"That red 'higher risk' label makes me feel I shouldn't do it at all."<cite>Maze exit note · anxious-international</cite></blockquote>
          </div>
        </div>
      </article>

      <!-- FIX 2 -->
      <article class="fix">
        <header class="fix-head">
          <span class="sev medium">Medium</span>
          <h3 class="fix-title">Even a confirm button left people unsure</h3>
          <span class="fix-mission">Mission 3 · 57% → 93% success</span>
        </header>
        <div class="fix-grid">
          <div class="ba">
            <span class="ba-tag before">Before</span>
            <div class="mock">
              <p class="mock-lead">Ready to book?</p>
              <div class="mock-btn">Confirm & book</div>
              <p class="mock-note">No amount on the button, no charge promise</p>
            </div>
          </div>
          <div class="ba">
            <span class="ba-tag after">After</span>
            <div class="mock">
              <p class="mock-lead">Ready to book?</p>
              <div class="mock-btn primary">Confirm & book · ₹31,400</div>
              <p class="mock-check">✓ You confirm every step. Nothing is booked without your OK.</p>
            </div>
          </div>
          <div class="changed">
            <p class="changed-label">What we changed</p>
            <p class="changed-body">Confirm-before-charge was a research must, so v1 already had a Confirm step, but testing showed people still hesitated with no amount on the button and nothing on screen promising they were safe. We put the exact price on the action and spelled out that nothing is charged without their OK.</p>
            <blockquote class="quote">"It says confirm, but confirm what exactly? For how much?"<cite>Maze exit note · refund-burned skeptic</cite></blockquote>
          </div>
        </div>
      </article>

      <!-- FIX 3 -->
      <article class="fix">
        <header class="fix-head">
          <span class="sev medium">Medium</span>
          <h3 class="fix-title">The sources were there, but nobody found them</h3>
          <span class="fix-mission">Mission 4 · 43% → 86% success</span>
        </header>
        <div class="fix-grid">
          <div class="ba">
            <span class="ba-tag before">Before</span>
            <div class="mock">
              <p class="mock-lead">Best route</p>
              <div class="mock-row"><b>DEL → DXB → LHR</b><span>₹31,400</span></div>
              <p class="mock-save">Save ₹18,400</p>
              <p class="mock-faint">Why this route ›</p>
              <p class="mock-note">A faint link at the bottom, no one tapped it</p>
            </div>
          </div>
          <div class="ba">
            <span class="ba-tag after">After</span>
            <div class="mock">
              <p class="mock-lead">Why this route</p>
              <div class="mock-src"><b>You save ₹18,400 (37%)</b><span>Source · Live fares · IndiGo + Emirates</span><span class="check">Check ›</span></div>
              <div class="mock-src"><b>Same terminal, on time 88%</b><span>Source · Dubai Airports map</span><span class="check">Check ›</span></div>
              <p class="mock-faint">AI-generated. Nothing is booked without your tap.</p>
            </div>
          </div>
          <div class="changed">
            <p class="changed-label">What we changed</p>
            <p class="changed-body">Showing sources was a research must, and v1 already had a Why this route link, but in testing no one noticed it. We relabelled it "reasoning & checkable sources" and opened it into a full explanation where every claim links to a source you can tap to check.</p>
            <blockquote class="quote">"Oh, I didn't even realise that was a link I could tap."<cite>Maze exit note · power optimizer</cite></blockquote>
          </div>
        </div>
      </article>
    </div>

    <p class="closing">Re-testing the current design lifted the Maze Usability Score from 62 to 84, task completion from 61% to 92%, and cut give-ups from 19% to 4%. The three fixes above account for most of that gain.</p>
  </div>
</section>

<style>
  /* tiles */
  .tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .tile { border: 1px solid var(--wf-border); border-radius: 16px; background: var(--wf-surface-muted); padding: 1.3rem 1.25rem; }
  .tile-n { font-size: 1.9rem; font-weight: 800; letter-spacing: -0.02em; color: var(--wf-text); margin: 0 0 0.6rem; }
  .tile-cap { font-size: 0.86rem; line-height: 1.5; color: var(--wf-text-muted); margin: 0; }

  /* metric cards */
  .res-kick { margin-top: 3rem; }
  .metrics { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1rem; }
  .metric { border: 1px solid var(--wf-border); border-radius: 16px; background: var(--wf-surface); padding: 1.2rem 1.1rem; }
  .m-label { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--wf-text-muted); margin: 0; }
  .m-big { font-size: 2.1rem; font-weight: 800; letter-spacing: -0.02em; color: var(--wf-text); margin: 0.5rem 0 0.6rem; }
  .m-foot { display: flex; align-items: center; gap: 0.5rem; margin: 0; font-size: 0.8rem; }
  .m-from { color: var(--wf-text-faint); }
  .m-delta { font-weight: 700; font-size: 0.74rem; padding: 0.15rem 0.5rem; border-radius: 999px; background: var(--wf-success-tint); color: var(--wf-success); }

  /* bar chart */
  .chart { margin-top: 1.5rem; border: 1px solid var(--wf-border); border-radius: 18px; background: var(--wf-surface); padding: 1.6rem 1.5rem; }
  .chart-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem; }
  .chart-title { font-size: 1.15rem; font-weight: 700; color: var(--wf-text); margin: 0; }
  .legend { display: flex; gap: 1rem; font-size: 0.8rem; color: var(--wf-text-muted); }
  .lg { display: inline-flex; align-items: center; gap: 0.4rem; }
  .lg::before { content: ''; width: 9px; height: 9px; border-radius: 50%; }
  .lg-v1::before { background: color-mix(in srgb, var(--wf-text-faint) 55%, var(--wf-border)); }
  .lg-cur::before { background: var(--wf-primary); }
  .bar-row { display: grid; grid-template-columns: 15rem 1fr 6rem; align-items: center; gap: 1rem; padding: 0.45rem 0; }
  .bar-name { font-size: 0.9rem; color: var(--wf-text); }
  .bar-track { position: relative; display: flex; height: 12px; border-radius: 999px; background: var(--wf-surface-muted); overflow: hidden; }
  .bar-v1 { background: color-mix(in srgb, var(--wf-text-faint) 45%, var(--wf-border)); }
  .bar-gain { background: var(--wf-primary); }
  .bar-nums { font-size: 0.85rem; color: var(--wf-text-muted); text-align: right; white-space: nowrap; }
  .bar-nums b { color: var(--wf-primary-text); }
  .bar-nums .arrow { color: var(--wf-text-faint); }

  /* maze report image */
  .report-kick { margin-top: 3rem; }
  .report { margin: 1.25rem 0 0; }
  .report img { width: 100%; height: auto; border: 1px solid var(--wf-border); border-radius: 18px; background: var(--wf-surface); }
  :global([data-theme='dark']) .report img { filter: brightness(0.94); }

  /* findings & fixes */
  .valid .wf-kicker { margin-top: 3rem; }
  .findings-intro { margin: 0 0 1.5rem; color: var(--wf-text-muted); font-size: 1.02rem; max-width: 70ch; }
  .fixes { display: flex; flex-direction: column; gap: 1.5rem; }
  .fix { border: 1px solid var(--wf-border); border-radius: 18px; background: var(--wf-surface); padding: 1.6rem 1.5rem; }
  .fix-head { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.4rem; }
  .sev { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; padding: 0.25rem 0.6rem; border-radius: 999px; }
  .sev.high { background: var(--wf-danger-tint); color: var(--wf-danger); }
  .sev.medium { background: var(--wf-warn-tint); color: var(--wf-warn); }
  .fix-title { font-size: 1.2rem; font-weight: 700; color: var(--wf-text); margin: 0; flex: 1 1 auto; }
  .fix-mission { font-size: 0.85rem; color: var(--wf-text-muted); }
  .fix-grid { display: grid; grid-template-columns: 1fr 1fr 1.2fr; gap: 1.25rem; align-items: start; }

  .ba-tag { display: inline-block; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.2rem 0.55rem; border-radius: 6px; margin-bottom: 0.7rem; }
  .ba-tag.before { background: var(--wf-surface-muted); color: var(--wf-text-muted); }
  .ba-tag.after { background: var(--wf-primary-tint); color: var(--wf-primary-text); }
  .mock { border: 1px solid var(--wf-border); border-radius: 12px; background: var(--wf-surface-muted); padding: 1rem; display: flex; flex-direction: column; gap: 0.55rem; }
  .mock-row { display: flex; justify-content: space-between; gap: 0.5rem; font-size: 0.9rem; color: var(--wf-text); }
  .mock-lead { font-size: 0.9rem; font-weight: 600; color: var(--wf-text); margin: 0; }
  .mock-box { border-radius: 8px; padding: 0.6rem 0.7rem; display: flex; flex-direction: column; gap: 0.2rem; font-size: 0.8rem; }
  .mock-box b { font-size: 0.82rem; }
  .mock-box.danger { background: var(--wf-danger-tint); color: var(--wf-danger); }
  .mock-box.warn { background: var(--wf-warn-tint); color: var(--wf-warn); }
  .mock-box span { color: var(--wf-text-muted); }
  .mock-check { font-size: 0.82rem; color: var(--wf-success); margin: 0; }
  .mock-note { font-size: 0.78rem; color: var(--wf-text-faint); margin: 0.1rem 0 0; }
  .mock-faint { font-size: 0.76rem; color: var(--wf-text-faint); margin: 0; }
  .mock-save { font-size: 0.82rem; color: var(--wf-success); margin: 0; }
  .mock-btn { text-align: center; border: 1px solid var(--wf-border); border-radius: 8px; padding: 0.55rem; font-size: 0.85rem; font-weight: 600; color: var(--wf-text); background: var(--wf-surface); }
  .mock-btn.primary { background: var(--wf-primary); color: var(--wf-on-primary); border-color: var(--wf-primary); }
  .pill { font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.5rem; border-radius: 999px; }
  .pill.success { background: var(--wf-success-tint); color: var(--wf-success); }
  .mock-src { border: 1px solid var(--wf-border); border-radius: 8px; background: var(--wf-surface); padding: 0.55rem 0.65rem; display: flex; flex-direction: column; gap: 0.15rem; font-size: 0.8rem; position: relative; }
  .mock-src b { font-size: 0.82rem; color: var(--wf-text); }
  .mock-src span { color: var(--wf-text-muted); }
  .mock-src .check { position: absolute; right: 0.65rem; top: 0.55rem; color: var(--wf-primary-text); font-weight: 600; }

  .changed-label { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--wf-text-muted); margin: 0 0 0.6rem; }
  .changed-body { font-size: 0.95rem; line-height: 1.6; color: var(--wf-text); margin: 0 0 1rem; }
  .quote { margin: 0; padding-left: 0.9rem; border-left: 3px solid var(--wf-primary); font-style: italic; color: var(--wf-text); font-size: 0.95rem; }
  .quote cite { display: block; margin-top: 0.4rem; font-style: normal; font-size: 0.78rem; color: var(--wf-text-faint); }

  .closing { margin-top: 1.75rem; border-radius: 16px; background: var(--wf-primary-tint); color: var(--wf-text); padding: 1.3rem 1.5rem; font-size: 1rem; line-height: 1.6; border: 1px solid color-mix(in srgb, var(--wf-primary) 25%, transparent); }

  @media (max-width: 900px) {
    .tiles { grid-template-columns: repeat(2, 1fr); }
    .metrics { grid-template-columns: repeat(2, 1fr); }
    .bar-row { grid-template-columns: 1fr; gap: 0.35rem; }
    .bar-nums { text-align: left; }
    .fix-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .tiles, .metrics { grid-template-columns: 1fr; }
  }
</style>
