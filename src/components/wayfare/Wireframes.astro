---
// 08 — Wireframes. Greyscale wireframe crops (2x) grouped by workflow.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (n: string) => `${base}/images/wayfare/w08-${n}.png`;

type Phone = [string, string];
const aiFlow: Phone[] = [
  ['warm-start', 'Warm start'],
  ['intake', 'Conversational intake'],
  ['voice', 'Voice input · listening'],
  ['deliberating', 'Deliberating · fetching routes'],
  ['reveal', 'Reveal · trade-offs'],
];
const manual: Phone[] = [
  ['m-search', 'Search + self-transfer switch'],
  ['m-filters', 'Filters'],
  ['m-results', 'Results, smart route first'],
];
const trips: Phone[] = [
  ['t-list', 'Trips list'],
  ['t-detail', 'Trip detail + day-of guidance'],
];
const plan: Phone[] = [
  ['doc-upload', 'Upload itinerary'],
  ['doc-reads', 'AI reads · trip details'],
];
const book: Phone[] = [
  ['seat', 'Choose seat'],
  ['pay', 'Swipe to pay'],
  ['boarding', 'Boarding pass'],
];
---

<section class="wf-section wires">
  <div class="wf-wrap">
    <p class="wf-eyebrow">08 · Wireframes</p>
    <h2 class="wf-h2">Structure before pixels.</h2>
    <p class="wf-intro">Every screen was sketched in greyscale first, logic and layout locked before any visual design. Grouped by workflow.</p>

    <div class="wire-group full">
      <p class="wf-kicker">AI Assistant Flow</p>
      <div class="wires-row">
        {aiFlow.map(([n, cap]) => (
          <figure class="wire-fig">
            <img src={img(n)} alt={`Wireframe: ${cap}`} width="168" height="336" loading="lazy" />
            <figcaption>{cap}</figcaption>
          </figure>
        ))}
      </div>
    </div>

    <div class="wire-pair">
      <div class="wire-group">
        <p class="wf-kicker">Manual Booking</p>
        <div class="wires-row">
          {manual.map(([n, cap]) => (
            <figure class="wire-fig">
              <img src={img(n)} alt={`Wireframe: ${cap}`} width="168" height="336" loading="lazy" />
              <figcaption>{cap}</figcaption>
            </figure>
          ))}
        </div>
      </div>
      <div class="wire-group">
        <p class="wf-kicker">Trips</p>
        <div class="wires-row">
          {trips.map(([n, cap]) => (
            <figure class="wire-fig">
              <img src={img(n)} alt={`Wireframe: ${cap}`} width="168" height="336" loading="lazy" />
              <figcaption>{cap}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>

    <div class="wire-pair">
      <div class="wire-group">
        <p class="wf-kicker">Plan with AI · Document upload</p>
        <div class="wires-row">
          {plan.map(([n, cap]) => (
            <figure class="wire-fig">
              <img src={img(n)} alt={`Wireframe: ${cap}`} width="168" height="336" loading="lazy" />
              <figcaption>{cap}</figcaption>
            </figure>
          ))}
        </div>
      </div>
      <div class="wire-group">
        <p class="wf-kicker">Book & boarding pass</p>
        <div class="wires-row">
          {book.map(([n, cap]) => (
            <figure class="wire-fig">
              <img src={img(n)} alt={`Wireframe: ${cap}`} width="168" height="336" loading="lazy" />
              <figcaption>{cap}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .wire-group { margin-top: 2.5rem; }
  .wire-group .wf-kicker { margin-bottom: 1rem; }
  .wire-pair {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }
  /* second pair: 2 + 3 phones -> give more room to the book group */
  .wire-pair:last-child { grid-template-columns: 2fr 3fr; }
  .wires-row {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.6rem, 1.4vw, 1.25rem);
  }
  .wire-fig {
    flex: 1 1 120px;
    max-width: 170px;
    margin: 0;
  }
  .wire-fig img {
    width: 100%;
    height: auto;
    border-radius: 14px;
    border: 1px solid var(--wf-border);
    background: var(--wf-surface);
    box-shadow: 0 12px 30px -22px rgba(15, 30, 60, 0.35);
  }
  :global([data-theme='dark']) .wire-fig img {
    /* keep the greyscale wireframe legible on dark: soften the white paper */
    filter: brightness(0.92);
    box-shadow: 0 14px 34px -20px rgba(0, 0, 0, 0.7);
  }
  .wire-fig figcaption {
    margin-top: 0.6rem;
    text-align: center;
    font-size: 0.78rem;
    color: var(--wf-text-muted);
  }

  @media (max-width: 820px) {
    .wire-pair, .wire-pair:last-child { grid-template-columns: 1fr; }
    .wires-row { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 0.6rem; -webkit-overflow-scrolling: touch; }
    .wire-fig { flex: 0 0 40%; max-width: 40%; }
  }
  @media (max-width: 520px) {
    .wire-fig { flex-basis: 52%; max-width: 52%; }
  }
</style>
