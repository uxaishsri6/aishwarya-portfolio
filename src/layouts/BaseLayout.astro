---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  showSectionDock?: boolean;
  wideNav?: boolean;
}

const {
  title,
  description = "Aishwarya Srivastava is a Senior UX/UI & Product Designer in Bengaluru with 5+ years across enterprise SaaS, telecom, cloud, healthcare, logistics, and CRM.",
  showSectionDock = true,
  wideNav = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="96x96" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Caveat:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="cursor-blob" id="blob" aria-hidden="true"></div>

    <header class="nav wrap" class:list={{ 'nav-wide': wideNav }}>
      <a class="brand" href={`${base}/`}>
        <img class="brand-mark" src={`${base}/favicon.png`} alt="" width="30" height="30" />
        Aishwarya Srivastava
      </a>
      <nav class="nav-links">
        <a href={`${base}/#about`}>About</a>
        <a href={`${base}/#work`}>Work</a>
        <a href={`${base}/#process`}>Process</a>
        <a href={`${base}/#contact`}>Contact</a>
      </nav>
      <div class="nav-right">
        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle day and night mode">
          <span class="tt-sun"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"/></g></svg></span>
          <span class="tt-moon"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M21 14.5A9 9 0 0 1 9.5 3a9 9 0 1 0 11.5 11.5z"/></svg></span>
        </button>
        <a class="resume-pill" href={`${base}/Aishwarya_Srivastava_Resume.pdf`} target="_blank" rel="noopener">Resume ↗</a>
        <button class="nav-toggle" id="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>

    <div class="mobile-menu" id="mobile-menu">
      <a href={`${base}/#about`}>About</a>
      <a href={`${base}/#work`}>Work</a>
      <a href={`${base}/#process`}>Process</a>
      <a href={`${base}/#contact`}>Contact</a>
      <a href={`${base}/Aishwarya_Srivastava_Resume.pdf`} target="_blank" rel="noopener">Resume ↗</a>
    </div>

    {showSectionDock && (
      <nav class="dock" id="dock" aria-label="Section navigation">
        <a href={`${base}/#top`} data-target="top"><span class="dot"></span> Home</a>
        <a href={`${base}/#about`} data-target="about"><span class="dot"></span> About</a>
        <a href={`${base}/#work`} data-target="work"><span class="dot"></span> Work</a>
        <a href={`${base}/#contact`} data-target="contact"><span class="dot"></span> Contact</a>
      </nav>
    )}

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-foot wrap">
      <div class="foot-cols">
        <div>
          <p class="foot-name">Aishwarya Srivastava</p>
          <p class="foot-sub">Product designer, Bengaluru, IST</p>
        </div>
        <ul class="foot-nav">
          <li><a href={`${base}/#work`}>Work</a></li>
          <li><a href={`${base}/#about`}>About</a></li>
          <li><a href={`${base}/#contact`}>Contact</a></li>
        </ul>
      </div>
      <p class="foot-meta">
        © <span id="year"></span>, Aishwarya Srivastava. Handmade in Bengaluru.
      </p>
    </footer>

    <style>
      .nav {
        position: sticky;
        top: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: var(--nav-h);
        padding-block: 0;
        /* transparent by default so it floats over the banner sky */
        background: transparent;
        border-bottom: 1px solid transparent;
        transition: background 0.35s var(--ease), border-color 0.35s var(--ease),
          backdrop-filter 0.35s var(--ease);
      }
      .nav-wide {
        max-width: 1200px;
      }
      /* translucent glass once scrolled past the banner: content shows through, softly blurred */
      .nav.scrolled {
        -webkit-backdrop-filter: saturate(1.6) blur(16px);
        backdrop-filter: saturate(1.6) blur(16px);
        background: color-mix(in srgb, var(--bg) 42%, transparent);
        border-bottom: 1px solid rgba(255, 255, 255, 0.5);
        box-shadow: 0 12px 32px -20px rgba(20, 40, 70, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.45);
      }
      :global([data-theme='dark']) .nav.scrolled {
        background: color-mix(in srgb, var(--bg) 48%, transparent);
        border-bottom-color: rgba(255, 255, 255, 0.12);
        box-shadow: 0 12px 32px -20px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.1);
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-weight: 600;
        letter-spacing: -0.01em;
      }
      .brand-mark {
        width: 30px;
        height: 30px;
        flex-shrink: 0;
        transition: transform 0.4s var(--ease);
      }
      .brand:hover .brand-mark {
        transform: scale(1.08);
      }
      .nav-links {
        display: flex;
        gap: 1.5rem;
        font-size: 0.95rem;
      }
      .nav-links a {
        position: relative;
        color: var(--ink-soft);
        transition: color 0.2s var(--ease);
      }
      .nav-links a::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -4px;
        width: 100%;
        height: 2px;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.3s var(--ease);
      }
      .nav-links a:hover {
        color: var(--ink);
      }
      .nav-links a:hover::after {
        transform: scaleX(1);
      }
      .nav-right {
        display: flex;
        align-items: center;
        gap: 0.85rem;
      }
      .theme-toggle {
        appearance: none;
        border: 1.5px solid var(--line);
        background: var(--card);
        color: var(--fg);
        width: 44px;
        height: 44px;
        border-radius: 50%;
        cursor: pointer;
        font-size: 1.4rem;
        line-height: 1;
        display: grid;
        place-items: center;
        transition: transform 0.3s var(--ease), border-color 0.3s var(--ease);
      }
      .theme-toggle:hover {
        transform: rotate(25deg) scale(1.08);
        border-color: var(--accent);
      }
      .tt-sun,
      .tt-moon {
        display: inline-flex;
      }
      .tt-moon {
        display: none;
      }
      :global([data-theme="dark"]) .tt-sun {
        display: none;
      }
      :global([data-theme="dark"]) .tt-moon {
        display: inline-flex;
        color: var(--accent);
      }
      :global([data-theme="dark"]) .theme-toggle {
        border-color: var(--accent);
        box-shadow: 0 0 14px -2px var(--accent);
      }
      .resume-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--paper);
        background: var(--accent);
        border: 1px solid var(--accent);
        border-radius: 999px;
        padding: 0.5rem 1rem;
        transition: transform 0.25s var(--ease), background 0.25s var(--ease),
          box-shadow 0.25s var(--ease);
      }
      .resume-pill:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 24px -12px var(--accent);
        background: color-mix(in srgb, var(--accent) 88%, #000);
      }
      .dot-live {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--accent-3);
        box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent-3) 60%, transparent);
        animation: pulse 2s infinite;
      }
      @keyframes pulse {
        0% {
          box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent-3) 60%, transparent);
        }
        70% {
          box-shadow: 0 0 0 8px transparent;
        }
        100% {
          box-shadow: 0 0 0 0 transparent;
        }
      }
      /* ---- floating nav dock ---- */
      .dock {
        position: fixed;
        right: 1.25rem;
        top: 50%;
        transform: translateY(-50%) translateX(20px);
        z-index: 90;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 0.6rem 0.7rem;
        border-radius: 16px;
        background: color-mix(in srgb, var(--card) 72%, transparent);
        border: 1px solid var(--line);
        backdrop-filter: saturate(1.3) blur(10px);
        box-shadow: 0 18px 40px -24px rgba(20, 40, 70, 0.4);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.4s var(--ease), transform 0.4s var(--ease);
      }
      .dock.show {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(-50%) translateX(0);
      }
      .dock a {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ink-faint);
        padding: 0.35rem 0.5rem;
        border-radius: 9px;
        transition: color 0.25s var(--ease), background 0.25s var(--ease);
      }
      .dock a .dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--ink-faint);
        transition: background 0.25s var(--ease), transform 0.25s var(--ease);
      }
      .dock a:hover {
        color: var(--ink);
      }
      .dock a.active {
        color: var(--ink);
        background: color-mix(in srgb, var(--accent) 12%, transparent);
      }
      .dock a.active .dot {
        background: var(--accent);
        transform: scale(1.5);
      }
      @media (max-width: 720px) {
        .dock { display: none; }
      }

      .site-foot {
        margin-top: 8rem;
        padding-block: 3rem 4rem;
        border-top: 1px solid var(--line);
      }
      .foot-cols {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 2rem;
      }
      .foot-name {
        font-family: var(--font-serif);
        font-size: 1.6rem;
      }
      .foot-sub {
        color: var(--ink-faint);
        font-size: 0.9rem;
      }
      .foot-nav {
        display: flex;
        gap: 1.5rem;
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: 0.95rem;
      }
      .foot-nav a:hover {
        color: var(--accent);
      }
      .foot-meta {
        margin-top: 2.5rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--ink-faint);
      }
      /* ---- hamburger + mobile menu ---- */
      .nav-toggle {
        display: none;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        width: 42px;
        height: 42px;
        padding: 0 9px;
        border: 1.5px solid var(--line);
        border-radius: 12px;
        background: var(--card);
        cursor: pointer;
      }
      .nav-toggle span {
        display: block;
        height: 2px;
        width: 100%;
        background: var(--fg);
        border-radius: 2px;
        transition: transform 0.3s var(--ease), opacity 0.2s var(--ease);
      }
      .nav-toggle[aria-expanded='true'] span:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
      }
      .nav-toggle[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
      .nav-toggle[aria-expanded='true'] span:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
      }
      .mobile-menu {
        position: fixed;
        top: var(--nav-h);
        left: 0;
        right: 0;
        z-index: 95;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 1rem var(--gutter) 1.5rem;
        background: color-mix(in srgb, var(--bg) 96%, transparent);
        backdrop-filter: saturate(1.4) blur(12px);
        border-bottom: 1px solid var(--line);
        transform: translateY(-12px);
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s var(--ease), transform 0.3s var(--ease),
          visibility 0.3s;
      }
      .mobile-menu.open {
        transform: translateY(0);
        opacity: 1;
        visibility: visible;
      }
      .mobile-menu a {
        padding: 0.85rem 0.25rem;
        font-size: 1.15rem;
        color: var(--ink);
        border-bottom: 1px solid var(--line);
      }
      .mobile-menu a:last-child {
        border-bottom: 0;
        color: var(--accent);
        font-weight: 600;
      }

      @media (max-width: 720px) {
        .nav-links { display: none; }
        .resume-pill { display: none; }
        .nav-toggle { display: flex; }
      }
      @media (min-width: 721px) {
        .mobile-menu { display: none; }
      }
    </style>

    <script>
      let workHistoryIndex: number | null = null;
      let returningToWork = false;
      let wiredBody: HTMLElement | null = null;
      let pageCleanups: (() => void)[] = [];
      let transitionCoverSlug: string | null = null;
      const isPlainClick = (event: MouseEvent) =>
        event.button === 0 && !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey;
      const homePath = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
      const projectPath = `${homePath}work/`;
      const projectSlug = (path: string) =>
        path.startsWith(projectPath) ? path.slice(projectPath.length).replace(/\/$/, '') : null;
      const selectProjectCover = (page: Document, slug: string) => {
        page.querySelectorAll<HTMLElement>('.scard .project-cover').forEach((cover) => {
          cover.style.viewTransitionName = cover.dataset.projectSlug === slug ? '' : 'none';
        });
      };

      // Runs on first load and after every View Transition navigation.
      function initTheme() {
        // default to dark; respect the visitor's explicit choice once they toggle
        const saved = localStorage.getItem('theme');
        const theme = saved || 'dark';
        document.documentElement.setAttribute('data-theme', theme);
      }
      initTheme();

      function wireUp() {
        if (wiredBody === document.body) return;
        pageCleanups.forEach((cleanup) => cleanup());
        pageCleanups = [];
        wiredBody = document.body;

        // year
        const y = document.getElementById('year');
        if (y) y.textContent = String(new Date().getFullYear());

        // theme toggle
        const toggle = document.getElementById('theme-toggle');
        if (toggle && !toggle.dataset.wired) {
          toggle.dataset.wired = '1';
          toggle.addEventListener('click', () => {
            const cur = document.documentElement.getAttribute('data-theme');
            const next = cur === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('theme', next);
          });
        }

        // mobile hamburger menu
        const navToggle = document.getElementById('nav-toggle');
        const mobileMenu = document.getElementById('mobile-menu');
        if (navToggle && mobileMenu && !navToggle.dataset.wired) {
          navToggle.dataset.wired = '1';
          const setOpen = (open: boolean) => {
            mobileMenu.classList.toggle('open', open);
            navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          };
          navToggle.addEventListener('click', () =>
            setOpen(!mobileMenu.classList.contains('open'))
          );
          mobileMenu.querySelectorAll('a').forEach((a) =>
            a.addEventListener('click', () => setOpen(false))
          );
          const onResize = () => {
            if (window.innerWidth > 720) setOpen(false);
          };
          window.addEventListener('resize', onResize);
          pageCleanups.push(() => window.removeEventListener('resize', onResize));
        }

        document.querySelectorAll<HTMLAnchorElement>('.scard-link').forEach((card) => {
          if (card.dataset.wired) return;
          card.dataset.wired = '1';
          card.addEventListener('click', (event) => {
            if (isPlainClick(event) && !event.defaultPrevented) {
              workHistoryIndex = typeof history.state?.index === 'number' ? history.state.index : null;
            }
          });
        });

        const allWork = document.querySelector<HTMLAnchorElement>('a.back');
        if (allWork && !allWork.dataset.wired) {
          allWork.dataset.wired = '1';
          allWork.addEventListener('click', (event) => {
            if (!isPlainClick(event) || event.defaultPrevented) return;
            returningToWork = true;
            const currentIndex = history.state?.index;
            if (workHistoryIndex !== null && typeof currentIndex === 'number' && currentIndex > workHistoryIndex) {
              event.preventDefault();
              history.go(workHistoryIndex - currentIndex);
            }
          });
        }

        // topbar backdrop + floating dock visibility + scroll-spy
        const nav = document.querySelector<HTMLElement>('.nav');
        const dock = document.querySelector<HTMLElement>('.dock');
        const dockLinks = dock ? [...dock.querySelectorAll<HTMLElement>('a')] : [];
        if (nav && !nav.dataset.wired) {
          nav.dataset.wired = '1';
          const spy = () => {
            const y = window.scrollY;
            nav.classList.toggle('scrolled', y > 40);
            if (dock) dock.classList.toggle('show', y > window.innerHeight * 0.6);
            // active section = last section whose top passed the 40% line
            let current = 'top';
            for (const link of dockLinks) {
              const id = link.dataset.target || '';
              const el = document.getElementById(id);
              if (el && el.getBoundingClientRect().top <= window.innerHeight * 0.4) {
                current = id;
              }
            }
            dockLinks.forEach((l) =>
              l.classList.toggle('active', l.dataset.target === current)
            );
          };
          window.addEventListener('scroll', spy, { passive: true });
          pageCleanups.push(() => window.removeEventListener('scroll', spy));
          spy();
        }

        // reveal on scroll — IntersectionObserver is progressive enhancement.
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        // Fallback: reveal anything already within the viewport using layout
        // geometry. IntersectionObserver does not fire while a document is
        // hidden (e.g. opened in a background tab), so this guarantees
        // above-the-fold content is never stuck invisible.
        const revealInView = () => {
          const vh = window.innerHeight || document.documentElement.clientHeight;
          document.querySelectorAll('.reveal:not(.in)').forEach((el) => {
            const r = el.getBoundingClientRect();
            if (r.top < vh * 0.92 && r.bottom > 0) el.classList.add('in');
          });
        };
        document.querySelectorAll('.reveal:not(.in)').forEach((el) => io.observe(el));
        pageCleanups.push(() => io.disconnect());
        revealInView();
        // Re-check when the tab becomes visible (IO may have been dormant).
        const onVisibilityChange = () => {
          if (!document.hidden) revealInView();
        };
        document.addEventListener('visibilitychange', onVisibilityChange);
        pageCleanups.push(() => document.removeEventListener('visibilitychange', onVisibilityChange));
        if (document.readyState !== 'complete') {
          window.addEventListener('load', revealInView, { once: true });
          pageCleanups.push(() => window.removeEventListener('load', revealInView));
        }

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        document.querySelectorAll<HTMLVideoElement>('video[data-play-in-view]').forEach((video) => {
          let visible = false;
          const updatePlayback = () => {
            if (!visible || reducedMotion.matches || document.hidden) {
              video.pause();
            } else if (video.paused) {
              void video.play().catch((error) => console.warn('Prototype preview could not play', error));
            }
          };
          const observer = new IntersectionObserver(([entry]) => {
            visible = entry.isIntersecting;
            updatePlayback();
          }, { threshold: 0.15, rootMargin: '120px 0px' });
          const onVisibilityChange = () => {
            if (!document.hidden) {
              const rect = video.getBoundingClientRect();
              visible = rect.top < window.innerHeight && rect.bottom > 0;
            }
            updatePlayback();
          };
          observer.observe(video);
          reducedMotion.addEventListener('change', updatePlayback);
          document.addEventListener('visibilitychange', onVisibilityChange);
          pageCleanups.push(() => {
            observer.disconnect();
            reducedMotion.removeEventListener('change', updatePlayback);
            document.removeEventListener('visibilitychange', onVisibilityChange);
            video.pause();
          });
        });

        // cursor blob (pointer devices only)
        const blob = document.getElementById('blob');
        if (blob && window.matchMedia('(hover: hover)').matches && !blob.dataset.wired) {
          blob.dataset.wired = '1';
          let x = window.innerWidth / 2,
            y2 = window.innerHeight / 2,
            tx = x,
            ty = y2,
            frame = 0;
          const loop = () => {
            x += (tx - x) * 0.15;
            y2 += (ty - y2) * 0.15;
            blob.style.transform = `translate(${x}px, ${y2}px) translate(-50%, -50%)`;
            frame = Math.abs(tx - x) + Math.abs(ty - y2) > 0.5 ? requestAnimationFrame(loop) : 0;
          };
          const onMouseMove = (e: MouseEvent) => {
            tx = e.clientX;
            ty = e.clientY;
            blob.style.opacity = '0.85';
            if (!frame) frame = requestAnimationFrame(loop);
          };
          const onMouseOver = (e: MouseEvent) => {
            const t = e.target as HTMLElement;
            const hot = t.closest('a, button, .project-card');
            blob.classList.toggle('hot', !!hot);
          };
          window.addEventListener('mousemove', onMouseMove);
          document.addEventListener('mouseover', onMouseOver);
          pageCleanups.push(() => {
            window.removeEventListener('mousemove', onMouseMove);
            document.removeEventListener('mouseover', onMouseOver);
            if (frame) cancelAnimationFrame(frame);
          });
        }

        // click interaction (mouse only): night = twinkling stars + twinkle, day = blue butterfly + petals + wind chime
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
                let audioCtx: AudioContext | null = null;
        const twinkle = () => {
          const AC = window.AudioContext || (window as any).webkitAudioContext;
          if (!AC) return;
          audioCtx = audioCtx || new AC();
          if (audioCtx.state === 'suspended') audioCtx.resume();
          const now = audioCtx.currentTime;
          // pentatonic bell notes, a few quick overlapping tones
          const notes = [1318.5, 1568, 1760, 2093, 2349.3];
          for (let i = 0; i < 3; i++) {
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            const t = now + i * 0.07;
            osc.type = 'sine';
            osc.frequency.value = notes[Math.floor(Math.random() * notes.length)];
            gain.gain.setValueAtTime(0.0001, t);
            gain.gain.exponentialRampToValueAtTime(0.07, t + 0.01);
            gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.7);
            osc.connect(gain).connect(audioCtx.destination);
            osc.start(t);
            osc.stop(t + 0.75);
          }
        };
        const windChime = () => {
          const AC = window.AudioContext || (window as any).webkitAudioContext;
          if (!AC) return;
          audioCtx = audioCtx || new AC();
          if (audioCtx.state === 'suspended') audioCtx.resume();
          const now = audioCtx.currentTime;
          // soft pentatonic tubes struck in a loose descending cascade
          const tubes = [2093, 1760, 1568, 1318.5, 1174.7, 1046.5];
          const start = Math.floor(Math.random() * 2);
          const hits = 4 + Math.floor(Math.random() * 2);
          for (let i = 0; i < hits; i++) {
            const t = now + i * (0.09 + Math.random() * 0.1);
            const freq = tubes[(start + i) % tubes.length];
            [1, 2.76].forEach((mult, k) => {
              const osc = audioCtx!.createOscillator();
              const gain = audioCtx!.createGain();
              osc.type = 'sine';
              osc.frequency.value = freq * mult;
              gain.gain.setValueAtTime(0.0001, t);
              gain.gain.exponentialRampToValueAtTime(k ? 0.012 : 0.055, t + 0.006);
              gain.gain.exponentialRampToValueAtTime(0.0001, t + (k ? 0.9 : 2.1));
              osc.connect(gain).connect(audioCtx!.destination);
              osc.start(t);
              osc.stop(t + 2.2);
            });
          }
        };
        // one graceful blue butterfly floats up from each daytime click
        const butterfly = (cx: number, cy: number) => {
          const size = 58;
          const wrap = document.createElement('span');
          wrap.setAttribute('aria-hidden', 'true');
          wrap.style.cssText =
            `position:fixed;left:${cx}px;top:${cy}px;width:${size}px;height:${size}px;` +
            `margin:${-size / 2}px 0 0 ${-size / 2}px;pointer-events:none;z-index:9999;will-change:transform,opacity;` +
            `filter:drop-shadow(0 3px 5px rgba(40,80,160,.35));`;
          wrap.innerHTML =
            `<svg viewBox="0 0 40 40" width="${size}" height="${size}" style="display:block;overflow:visible">` +
            `<defs><linearGradient id="bf-up" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#8fd0ff"/><stop offset="1" stop-color="#2f6bff"/></linearGradient>` +
            `<linearGradient id="bf-lo" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#b9e4ff"/><stop offset="1" stop-color="#5b8cff"/></linearGradient></defs>` +
            `<path d="M20 20C13 4 1 5 2 14c1 7 9 8 18 6z" fill="url(#bf-up)"/>` +
            `<path d="M20 20C27 4 39 5 38 14c-1 7-9 8-18 6z" fill="url(#bf-up)"/>` +
            `<path d="M20 21C12 23 6 29 9.5 34c3.5 4.5 9.5 0 10.5-13z" fill="url(#bf-lo)"/>` +
            `<path d="M20 21C28 23 34 29 30.5 34c-3.5 4.5-9.5 0-10.5-13z" fill="url(#bf-lo)"/>` +
            `<g fill="#fff" opacity=".85"><circle cx="9" cy="11.5" r="1.7"/><circle cx="31" cy="11.5" r="1.7"/><circle cx="13" cy="8" r="1"/><circle cx="27" cy="8" r="1"/><circle cx="11.5" cy="30" r="1.1"/><circle cx="28.5" cy="30" r="1.1"/></g>` +
            `<rect x="19" y="12" width="2" height="19" rx="1" fill="#1d2f6f"/>` +
            `<path d="M19.5 12c-2-4-4-5.5-5.5-5.5M20.5 12c2-4 4-5.5 5.5-5.5" stroke="#1d2f6f" stroke-width="1" fill="none" stroke-linecap="round"/>` +
            `</svg>`;
          document.body.appendChild(wrap);
          const svg = wrap.firstElementChild as SVGElement;
          const dir = Math.random() < 0.5 ? -1 : 1;
          const dx = dir * (90 + Math.random() * 90);
          const rise = 190 + Math.random() * 110;
          const sway = 35 + Math.random() * 25;
          const dur = 3400 + Math.random() * 800;
          const tilt = dir * 14;
          const move = wrap.animate(
            [
              { transform: 'translate(0,0) scale(0.4) rotate(0deg)', opacity: 0 },
              { transform: `translate(${dx * 0.2 + sway}px,${-rise * 0.2}px) scale(1) rotate(${tilt}deg)`, opacity: 1, offset: 0.12 },
              { transform: `translate(${dx * 0.45 - sway}px,${-rise * 0.45}px) scale(1) rotate(${-tilt}deg)`, opacity: 1, offset: 0.35 },
              { transform: `translate(${dx * 0.7 + sway}px,${-rise * 0.7}px) scale(0.95) rotate(${tilt}deg)`, opacity: 1, offset: 0.62 },
              { transform: `translate(${dx * 0.9 - sway * 0.6}px,${-rise * 0.9}px) scale(0.9) rotate(${-tilt}deg)`, opacity: 0.9, offset: 0.85 },
              { transform: `translate(${dx}px,${-rise}px) scale(0.8) rotate(${tilt}deg)`, opacity: 0 },
            ],
            { duration: dur, easing: 'ease-out', fill: 'forwards' },
          );
          svg.animate(
            [{ transform: 'scaleX(1)' }, { transform: 'scaleX(0.28)' }, { transform: 'scaleX(1)' }],
            { duration: 300, iterations: Math.ceil(dur / 300), easing: 'ease-in-out' },
          );
          move.onfinish = () => wrap.remove();
        };
        const PETAL_COLORS = ['#ffc2d4', '#ffd9e4', '#ffffff', '#ffb3c6', '#ffe3d1'];
        const petals = (cx: number, cy: number) => {
          const count = 12;
          for (let i = 0; i < count; i++) {
            const el = document.createElement('span');
            const w = 9 + Math.random() * 8;
            el.setAttribute('aria-hidden', 'true');
            el.style.cssText =
              `position:fixed;left:${cx}px;top:${cy}px;width:${w}px;height:${w * 1.35}px;` +
              `margin:${-w / 2}px 0 0 ${-w / 2}px;pointer-events:none;z-index:9999;` +
              `background:${PETAL_COLORS[i % PETAL_COLORS.length]};border-radius:80% 0 80% 0;` +
              `box-shadow:inset -1px -1px 2px rgba(214,96,130,.25);will-change:transform,opacity;`;
            document.body.appendChild(el);
            const angle = Math.random() * Math.PI * 2;
            const dist = 25 + Math.random() * 60;
            const dx = Math.cos(angle) * dist;
            const dy = Math.sin(angle) * dist - 30;
            const drift = (Math.random() < 0.5 ? -1 : 1) * (30 + Math.random() * 60);
            const fall = 140 + Math.random() * 180;
            const spin = (Math.random() < 0.5 ? -1 : 1) * (180 + Math.random() * 360);
            const dur = 1800 + Math.random() * 1400;
            const anim = el.animate(
              [
                { transform: 'translate(0,0) scale(0.3) rotate(0deg)', opacity: 0 },
                { transform: `translate(${dx}px,${dy}px) scale(1) rotate(${spin * 0.2}deg)`, opacity: 1, offset: 0.18 },
                { transform: `translate(${dx + drift * 0.5}px,${dy + fall * 0.45}px) scale(1) rotate(${spin * 0.55}deg) rotateY(60deg)`, opacity: 1, offset: 0.55 },
                { transform: `translate(${dx - drift * 0.3}px,${dy + fall * 0.8}px) scale(0.95) rotate(${spin * 0.8}deg) rotateY(-50deg)`, opacity: 0.9, offset: 0.82 },
                { transform: `translate(${dx + drift}px,${dy + fall}px) scale(0.8) rotate(${spin}deg)`, opacity: 0 },
              ],
              { duration: dur, easing: 'cubic-bezier(.3,.6,.5,1)', fill: 'forwards' },
            );
            anim.onfinish = () => el.remove();
          }
        };
        const burst = (cx: number, cy: number) => {
          const count = 16;
          for (let i = 0; i < count; i++) {
            const el = document.createElement('span');
            const size = 12 + Math.random() * 14;
            el.setAttribute('aria-hidden', 'true');
            el.style.cssText =
              `position:fixed;left:${cx}px;top:${cy}px;width:${size}px;height:${size}px;` +
              `margin:${-size / 2}px 0 0 ${-size / 2}px;pointer-events:none;z-index:9999;` +
              `background:#fff;` +
              `clip-path:polygon(50% 0,61% 39%,100% 50%,61% 61%,50% 100%,39% 61%,0 50%,39% 39%);` +
              `filter:drop-shadow(0 0 6px rgba(255,255,255,1));will-change:transform,opacity;`;
            document.body.appendChild(el);
            const angle = Math.random() * Math.PI * 2;
            const dist = 30 + Math.random() * 70;
            const dx = Math.cos(angle) * dist;
            const dy = Math.sin(angle) * dist - 20;
            const fall = 90 + Math.random() * 140;
            const spin = (Math.random() - 0.5) * 360;
            const anim = el.animate(
              [
                { transform: 'translate(0,0) scale(0.3) rotate(0deg)', opacity: 1 },
                { transform: `translate(${dx * 0.6}px,${dy * 0.6}px) scale(1.15) rotate(${spin * 0.2}deg)`, opacity: 1, offset: 0.2 },
                { transform: `translate(${dx}px,${dy}px) scale(0.55) rotate(${spin * 0.4}deg)`, opacity: 0.35, offset: 0.35 },
                { transform: `translate(${dx * 1.07}px,${dy + fall * 0.3}px) scale(1.05) rotate(${spin * 0.55}deg)`, opacity: 1, offset: 0.5 },
                { transform: `translate(${dx * 1.14}px,${dy + fall * 0.55}px) scale(0.5) rotate(${spin * 0.7}deg)`, opacity: 0.3, offset: 0.65 },
                { transform: `translate(${dx * 1.2}px,${dy + fall * 0.8}px) scale(0.9) rotate(${spin * 0.85}deg)`, opacity: 0.9, offset: 0.8 },
                { transform: `translate(${dx * 1.25}px,${dy + fall}px) scale(0.2) rotate(${spin}deg)`, opacity: 0 },
              ],
              { duration: 900 + Math.random() * 700, easing: 'cubic-bezier(.2,.6,.4,1)', fill: 'forwards' },
            );
            anim.onfinish = () => el.remove();
          }
        };
        // the sun / moon: click it to make it twist and turn in place with a smiley face
        const orbHit = (x: number, y: number) => {
          const dark = document.documentElement.getAttribute('data-theme') === 'dark';
          const body = document.querySelector<HTMLElement>(dark ? '.fx-moon' : '.fx-sun');
          if (!body) return null;
          const r = body.getBoundingClientRect();
          if (r.width === 0) return null;
          const cx = r.left + r.width / 2;
          const cy = r.top + r.height / 2;
          return Math.hypot(x - cx, y - cy) <= r.width / 2 + 4 ? body.closest<HTMLElement>('.orb') : null;
        };
        const isInteractive = (t: EventTarget | null) =>
          t instanceof Element && !!t.closest('a, button, input, textarea, select, summary, label');
        const onOrbMove = (e: MouseEvent) => {
          document.documentElement.classList.toggle('orb-hover', !isInteractive(e.target) && !!orbHit(e.clientX, e.clientY));
        };
        document.addEventListener('mousemove', onOrbMove);
        pageCleanups.push(() => document.removeEventListener('mousemove', onOrbMove));
        const playOrb = (orb: HTMLElement) => {
          orb.classList.remove('playing');
          void orb.offsetWidth; // restart the animation if it is already running
          orb.classList.add('playing');
          window.setTimeout(() => orb.classList.remove('playing'), 2000);
        };
        const onSparkleClick = (e: MouseEvent) => {
          if (e.detail === 0 || reduceMotion.matches) return;
          if (!isInteractive(e.target)) {
            const orb = orbHit(e.clientX, e.clientY);
            if (orb) {
              playOrb(orb);
              return;
            }
          }
          if (document.documentElement.getAttribute('data-theme') === 'dark') {
            burst(e.clientX, e.clientY);
            twinkle();
          } else {
            butterfly(e.clientX, e.clientY);
            petals(e.clientX, e.clientY);
            windChime();
          }
        };
        document.addEventListener('click', onSparkleClick);
        pageCleanups.push(() => document.removeEventListener('click', onSparkleClick));

        // magnetic buttons
        document.querySelectorAll<HTMLElement>('.magnetic').forEach((el) => {
          if (el.dataset.wired) return;
          el.dataset.wired = '1';
          el.addEventListener('mousemove', (e) => {
            const r = el.getBoundingClientRect();
            const mx = e.clientX - r.left - r.width / 2;
            const my = e.clientY - r.top - r.height / 2;
            el.style.transform = `translate(${mx * 0.25}px, ${my * 0.35}px)`;
          });
          el.addEventListener('mouseleave', () => {
            el.style.transform = '';
          });
        });
      }

      wireUp();
      document.addEventListener('astro:before-preparation', (event) => {
        transitionCoverSlug = event.from.pathname === homePath
          ? projectSlug(event.to.pathname)
          : event.to.pathname === homePath ? projectSlug(event.from.pathname) : null;
      });
      document.addEventListener('astro:after-preparation', () => {
        if (transitionCoverSlug && document.getElementById('work')) {
          selectProjectCover(document, transitionCoverSlug);
        }
      });
      document.addEventListener('astro:before-swap', (event) => {
        if (transitionCoverSlug && event.newDocument.getElementById('work')) {
          selectProjectCover(event.newDocument, transitionCoverSlug);
        }
        if (returningToWork && event.newDocument.getElementById('work')) {
          event.newDocument.documentElement.classList.add('instant-work-return');
        }
      });
      document.addEventListener('astro:after-swap', () => {
        returningToWork = false;
        transitionCoverSlug = null;
        if (document.getElementById('work')) workHistoryIndex = null;
        initTheme();
        wireUp();
      });
      document.addEventListener('astro:page-load', () => {
        document.documentElement.classList.remove('instant-work-return');
        wireUp();
      });
    </script>
  </body>
</html>
