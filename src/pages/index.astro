---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SkyFX from '../components/SkyFX.astro';
import Marquee from '../components/Marquee.astro';
import About from '../components/About.astro';
import Process from '../components/Process.astro';
import Contact from '../components/Contact.astro';
import ProjectCard from '../components/ProjectCard.astro';

const studies = (await getCollection('case-studies', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const count = studies.length;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Aishwarya Srivastava — Senior UX/UI & Product Designer">
  <div class="sky-world">
  <SkyFX />
  <Hero />

  <Marquee />

  <About />

  <section id="work" class="work">
    <div class="wrap work-wrap">
      <div class="work-head reveal">
        <h2 class="work-title">Case studies</h2>
        <span class="work-count">{String(count).padStart(2, '0')} projects · scroll to explore</span>
      </div>
      <ul class="cards">
        {studies.map((s, i) => (
          <ProjectCard
            slug={s.slug}
            index={i}
            num={String(i + 1).padStart(2, '0')}
            tag={s.data.tag}
            title={s.data.cardTitle}
            lede={s.data.lede}
            metric={s.data.metric}
            accent={s.data.accent}
            cover={s.data.cover}
          />
        ))}
      </ul>
    </div>
  </section>
  </div>

  <div class="wrap">
    <Process />
  </div>

  <Contact />
</BaseLayout>

<style>
  /* one continuous sky behind cover → marquee → about → work,
     fading into the ground (paper) at the bottom for a smooth handoff */
  .sky-world {
    position: relative;
    background: linear-gradient(
      180deg,
      #7cc0f5 0%,
      #a9d6fb 12%,
      #cfe9ff 34%,
      #dceeff 62%,
      #e9f4ff 88%,
      var(--paper) 100%
    );
  }
  :global([data-theme='dark']) .sky-world {
    background: linear-gradient(
      180deg,
      #0a1430 0%,
      #101c3e 22%,
      #0d1836 52%,
      #0b1228 84%,
      var(--paper) 100%
    );
  }

  .work {
    position: relative;
    /* background provided by the shared .sky-world wrapper */
    padding-block: clamp(4rem, 9vh, 7rem) clamp(6rem, 14vh, 11rem);
    /* NOTE: no overflow:hidden here — it would break the sticky card stack */
  }
  .work-wrap { position: relative; z-index: 2; }
  .work-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: 1.25rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid color-mix(in srgb, #1e2c4f 18%, transparent);
  }
  :global([data-theme='dark']) .work-head {
    border-bottom-color: color-mix(in srgb, #ffffff 18%, transparent);
  }
  .work-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2rem, 5vw, 3.4rem);
    letter-spacing: -0.02em;
    color: #12233c;
  }
  :global([data-theme='dark']) .work-title { color: #f4f7ff; }
  .work-count {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #3a5573;
  }
  :global([data-theme='dark']) .work-count { color: #9fb0d8; }
  .cards {
    margin: 0;
    padding: 0;
    display: block;
  }
</style>
