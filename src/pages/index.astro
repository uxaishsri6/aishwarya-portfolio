---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import About from '../components/About.astro';
import Process from '../components/Process.astro';
import Contact from '../components/Contact.astro';
import ProjectCard from '../components/ProjectCard.astro';

const studies = (await getCollection('case-studies', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const count = studies.length;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Aishwarya Srivastava, Product Designer">
  <Hero />

  <Marquee />

  <About />

  <section id="work" class="work">
    <div class="work-sky" aria-hidden="true">
      <img src={`${base}/images/cloud-1.png`} alt="" style="top:6%; left:-6%; width:340px; opacity:.7" />
      <img src={`${base}/images/cloud-2.png`} alt="" style="top:2%; right:-4%; width:300px; opacity:.6" />
      <img src={`${base}/images/cloud-2.png`} alt="" style="bottom:8%; left:2%; width:320px; opacity:.5" />
      <img src={`${base}/images/cloud-1.png`} alt="" style="bottom:2%; right:-6%; width:360px; opacity:.6" />
    </div>

    <div class="wrap work-wrap">
      <div class="work-head reveal">
        <h2 class="work-title">Case studies</h2>
        <span class="work-count">{String(count).padStart(2, '0')} projects · scroll to explore</span>
      </div>
      <ul class="cards">
        {studies.map((s, i) => (
          <ProjectCard
            slug={s.slug}
            index={i}
            num={String(i + 1).padStart(2, '0')}
            tag={s.data.tag}
            title={s.data.cardTitle}
            lede={s.data.lede}
            metric={s.data.metric}
            accent={s.data.accent}
            cover={s.data.cover}
          />
        ))}
      </ul>
    </div>
  </section>

  <div class="wrap">
    <Process />
    <Contact />
  </div>
</BaseLayout>

<style>
  .work {
    position: relative;
    /* always a light cloud sky, matching the cover world */
    background: linear-gradient(180deg, #a9d6fb 0%, #cfe9ff 40%, #e8f4ff 100%);
    padding-block: clamp(4rem, 9vh, 7rem) clamp(6rem, 14vh, 11rem);
    /* NOTE: no overflow:hidden here — it would break the sticky card stack */
    /* force a light palette on the cards regardless of theme toggle */
    --card: #fbf8f0;
    --ink: #1e2c4f;
    --ink-soft: #465270;
    --ink-faint: #8b91a3;
    --line: #e0dccd;
  }
  .work-sky { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .work-sky img { position: absolute; height: auto; filter: blur(1px); }

  .work-wrap { position: relative; z-index: 2; }
  .work-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: 1.25rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid color-mix(in srgb, #1e2c4f 18%, transparent);
  }
  .work-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2rem, 5vw, 3.4rem);
    letter-spacing: -0.02em;
    color: #12233c;
  }
  .work-count {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #3a5573;
  }
  .cards {
    margin: 0;
    padding: 0;
    display: block;
  }
</style>
